;;;; systems/orchestrator-cli/deontic-gate.lisp
;;;; ============================================================================
;;;; Η ΠΥΛΗ ΤΟΥ ΔΕΟΝΤΙΚΟΥ ΤΑΞΙΝΟΜΗΤΗ — τα πρότυπα αστοχίας, κλειδωμένα για πάντα
;;;; ============================================================================
;;;;
;;;; Κάθε περίπτωση εδώ προέρχεται από ΜΕΤΡΗΜΕΝΟ αντιπαραθετικό έλεγχο (163
;;;; δείγματα, 5 ανεξάρτητοι κριτές, 7 ριζικά πρότυπα αστοχίας — α' γύρος 56%
;;;; ορθότητα). Ό,τι αστόχησε μία φορά γίνεται ΓΙΑ ΠΑΝΤΑ test: προτεραιότητα
;;;; τελεστών, σημασιολογία άρνησης (¬P=F, ¬O προσωπικού=P, ¬επιταγή απρόσωπη=F),
;;;; ορισμικός φραγμός, κυριαρχία «όποιος…τιμωρείται» και «μπορεί να».

(in-package :orchestrator.cli)

(defparameter *deontic-suite*
  '(;; Π1: ουσιαστικό «ποινή/απαγόρευση» σε αναφορική θέση → ΚΑΝΕΝΑ
    ("Κατά της απόφασης με την οποία απειλείται ποινή χωρεί έφεση."          nil)
    ("Η ποινή που επιβλήθηκε εκτίεται κατά τις διατάξεις του παρόντος."      nil)
    ("Ισχύει ό,τι και στην απαγόρευση από τον νόμο."                          nil)
    ;; Π2: ορισμικός/διαπλαστικός λόγος → ΚΑΝΕΝΑ
    ("Από αμέλεια πράττει όποιος δεν κατέβαλε την επιμέλεια που όφειλε."      nil)
    ("Η προθεσμία θεωρείται ότι τηρήθηκε αν η κατάθεση έγινε εμπρόθεσμα."     nil)
    ;; Π3: εξωτερικό τροπικό ευχέρειας κυριαρχεί του εγκιβωτισμένου → ΑΔΕΙΑ
    ("Το δικαστήριο μπορεί να υποχρεώσει τον διάδικο σε προκαταβολή των εξόδων." :permission)
    ("Με προεδρικό διάταγμα μπορεί να ορίζεται υποχρεωτικά η διαδικασία."     :permission)
    ;; Π4: άρνηση τελεστή άδειας/δυνατότητας → ΑΠΑΓΟΡΕΥΣΗ (¬P=F)
    ("Δεν επιτρέπεται η μεταβολή της κατηγορίας."                             :prohibition)
    ("Αναγκαστική εκτέλεση δεν μπορεί να γίνει κατά του Δημοσίου."            :prohibition)
    ("Ο διάδικος δεν έχει δικαίωμα να προσβάλει την απόφαση παρά μόνο αν."    :prohibition)
    ;; Π5: «όποιος … τιμωρείται» κυριαρχεί των στοιχείων του αδίκου → ΑΠΑΓΟΡΕΥΣΗ
    ("Όποιος χωρίς δικαίωμα αποκτά πρόσβαση σε σύστημα πληροφοριών τιμωρείται με φυλάκιση." :prohibition)
    ("Έγκυος που επιτρέπει σε άλλον να επενεργήσει τιμωρείται με φυλάκιση."   :prohibition)
    ;; Π6: αρνημένο ΠΡΟΣΩΠΙΚΟ καθήκον → ΑΔΕΙΑ (απαλλαγή)· αρνημένη ΑΠΡΟΣΩΠΗ επιταγή → ΑΠΑΓΟΡΕΥΣΗ
    ("Οι μάρτυρες δεν είναι υποχρεωμένοι να καταθέσουν."                      :permission)
    ("Ο κληρονόμος δεν υποχρεούται σε καταβολή πέραν του ενεργητικού."        :permission)
    ("Η δήμευση δεν επιβάλλεται όταν το πράγμα ανήκει σε τρίτον."             :prohibition)
    ;; Π7: «έχει το δικαίωμα να» → ΑΔΕΙΑ
    ("Ο Πρόεδρος έχει το δικαίωμα να χαρίζει ή να μετατρέπει τις ποινές."     :permission)
    ;; Βασικοί θετικοί τελεστές
    ("Όποιος αφαιρεί ξένο κινητό πράγμα τιμωρείται με φυλάκιση."              :prohibition)
    ("Ο πωλητής οφείλει να παραδώσει το πράγμα ελεύθερο βαρών."               :obligation)
    ("Ο δανειστής δικαιούται να απαιτήσει αποζημίωση."                        :permission)
    ("Η αγωγή πρέπει να ασκηθεί εντός έξι μηνών."                             :obligation)
    ;; Άρνηση βασικών (από τον πρώτο εντοπισμό του bug)
    ("Η πράξη δεν τιμωρείται αν έγινε σε κατάσταση άμυνας."                   nil)
    ("Επιτρέπεται η παραίτηση από το δικαίωμα."                               :permission)
    ;; ── β' γύρος κριτών (81,5%) — πρότυπα Α-Ε ──
    ;; Α: αληθικό «μπορεί» σε υπόθεση δεν προστάζει· προστάζει η απόδοση
    ("Αν η ενοχή δεν μπορεί να αποδειχθεί, διατάσσεται η απόλυση του κατηγορουμένου." :obligation)
    ("Αν ο πλειστηριασμός δεν μπορεί να ολοκληρωθεί, το δικαστήριο μπορεί να αποφασίσει την αναβολή." :permission)
    ;; Β: τελεστής σε αναφορική δεν νικά την κύρια πρόταση· «τιμωρήθηκαν» περιγράφει
    ("Για τα εγκλήματα που τιμωρούνται με κάθειρξη επιβάλλεται συνολική ποινή." :obligation)
    ("Όσοι τιμωρήθηκαν με φυλάκιση δικαιούνται να ζητήσουν αναστολή."          :permission)
    ;; Γ: ουσιαστικά («η δέσμευση», «ο οφειλέτης») δεν είναι τελεστές
    ("Η δέσμευση ισχύει από τη χρονική στιγμή της επίδοσης."                   nil)
    ("Το δικαίωμα επιλογής περιέρχεται στον δανειστή."                         nil)
    ;; Δ: ασυνεχές «μπορεί … να», επιρρηματική ευχέρεια, λεξική απαλλαγή
    ("Το δικαστήριο μπορεί με αίτηση του εισαγγελέα να διατάξει την αναβολή."  :permission)
    ("Η αποζημίωση κρίνεται ελεύθερα από το δικαστήριο."                       :permission)
    ("Ο εγγυητής απαλλάσσεται από κάθε υποχρέωση."                             :permission)
    ;; Ε: αποκλειστικό «μόνο» = απαγόρευση του εκτός-όρου
    ("Η διαδικασία μπορεί να αποδειχθεί μόνο με τα πρακτικά της συνεδρίασης."  :prohibition)
    ("Οι ποινές επιβάλλονται μόνο ύστερα από σύμφωνη γνώμη του συμβουλίου."    :prohibition)
    ;; ── γ' γύρος κριτών (91,5%) — τα εναπομείναντα πρότυπα ──
    ;; συμπλήρωμα αποφαντικού ρήματος = περιεχόμενο απόφασης, όχι κανόνας του χωρίου
    ("Το συμβούλιο αποφαίνεται ότι δεν πρέπει να απαγγελθεί κατηγορία."        nil)
    ;; συστατικός όρος κύρους («για να έχει … πρέπει») δεν είναι επιταγή
    ("Για να έχει αποδεικτική δύναμη το έγγραφο πρέπει να φέρει ιδιόχειρη υπογραφή." nil)
    ;; ορισμός («συνίσταται σε») δεν είναι επιταγή
    ("Η ικανοποίηση συνίσταται σε πληρωμή ή σε οτιδήποτε επιβάλλεται από τις περιστάσεις." nil)
    ;; παραπεμπτικός μετα-κανόνας / επιφύλαξη νόμου
    ("Η διάταξη εφαρμόζεται και για τα κατεπείγοντα μέτρα, αν η ασφάλιση επιβάλλεται από τους κανόνες." nil)
    ;; αόριστος «δεν μπόρεσε» = αληθική αδυναμία· προστάζει η κύρια («μπορεί να»)
    ("Αν ο κατηγορούμενος δεν μπόρεσε εγκαίρως να γνωστοποιήσει το κώλυμα, μπορεί να υποβάλει αίτηση." :permission)
    ;; απαρίθμηση: το «μπορεί:» διαπερνά τα α)/β)
    ("Το δικαστήριο μπορεί: α) να διατάξει την προσωρινή κράτηση ή β) να επιβάλει περιοριστικούς όρους." :permission)
    ;; ποσοδείκτης «ένα μόνο» ΔΕΝ είναι αποκλειστικός κανόνας
    ("Αρκεί να του παραδοθεί ένα μόνο αντίγραφο της αγωγής."                   :permission))
  "πρόταση → αναμενόμενη τυπικότητα (nil = κανένα δεοντικό περιεχόμενο).")

(defun run-deontic-gate ()
  "--deontic-gate : τρέξε τη σουίτα του δεοντικού ταξινομητή. Μία αποτυχία ⇒ exit 1."
  (let ((fails '()))
    (dolist (c *deontic-suite*)
      (destructuring-bind (s expect) c
        (let ((got (orchestrator.extraction:classify-deontic-sentence s)))
          (if (eq got expect)
              (format t "  ✓ ~S ← «~A»~%" got s)
              (progn (push (list s expect got) fails)
                     (format t "  ✗ «~A»~%      περίμενα ~S, πήρα ~S~%" s expect got))))))
    (format t "~%── ΠΥΛΗ ΔΕΟΝΤΙΚΟΥ: ~D/~D πέρασαν ──~%"
            (- (length *deontic-suite*) (length fails)) (length *deontic-suite*))
    (if fails 1 0)))

(register-command "--deontic-gate" (lambda (a) (declare (ignore a)) (run-deontic-gate)))

(orchestrator.self-model:declare-capability! "δεοντικό"
 :description "τι ΠΡΟΣΤΑΖΕΙ ο κανόνας (O/F/P): ταξινόμηση + κανονιστική σύγκρουση"
 :package :orchestrator.deontic :functions '("evaluate-deontic" "classify-deontic-sentence")
 :gate "--deontic-gate" :depends-on '("συμπερασμός-wfs"))
