<NIL/1975/art/1/genesis> a prov:Activity, slw:OriginAssertion ;
    rdfs:label "Article 1 Genesis Event"@en ;
    prov:startedAtTime "2025-12-22T22:39:48Z"^^xsd:dateTime ;
    prov:endedAtTime "2025-12-22T22:39:48Z"^^xsd:dateTime ;
    slw:blockchainAnchor "pending" ;
