<https://stavropouloslaw.com/eli/gr/pd/1985/503/art/496/work/exp/ell>
    a eli:LegalExpression;
    eli:realizes <https://stavropouloslaw.com/eli/gr/pd/1985/503/art/496/work>;
    eli:is_part_of <https://stavropouloslaw.com/eli/gr/pd/1985/503/art/496>;
