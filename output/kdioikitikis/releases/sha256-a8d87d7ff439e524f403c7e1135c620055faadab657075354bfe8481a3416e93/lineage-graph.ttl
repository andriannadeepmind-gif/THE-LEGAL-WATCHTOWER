<https://stavropouloslaw.com/lineage/2025> a prov:Collection ;
    dcterms:title "Greek Constitution Identity Lineage Graph"@en ;
    dcterms:created "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    dcterms:creator <https://stavropouloslaw.com/identity/org> ;
    slw:totalArticles 304 ;
    rdfs:comment """PROV-O lineage graph tracking identity
        continuity of all articles. Each article has genesis event with
        blockchain-backed timestamp."""@en .

