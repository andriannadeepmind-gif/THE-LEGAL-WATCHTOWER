<https://stavropouloslaw.com/eli/gr/const/1975/art/1/genesis> a prov:Activity, slw:OriginAssertion ;
    rdfs:label "Article 1 Genesis Event"@en ;
    prov:startedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    slw:blockchainAnchor "pending" ;
