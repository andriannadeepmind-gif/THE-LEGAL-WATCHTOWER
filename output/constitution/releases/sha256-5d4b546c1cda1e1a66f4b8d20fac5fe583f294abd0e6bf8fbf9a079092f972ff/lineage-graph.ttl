    rdfs:label "Article 44 Identity"@en ;
    prov:wasGeneratedBy <https://stavropouloslaw.com/eli/gr/const/1975/art/44/genesis> ;
    slw:identityHash "NIL" ;
    slw:genesisProof "pending" ;
    dcterms:identifier <https://stavropouloslaw.com/eli/gr/const/1975/art/44> .

<https://stavropouloslaw.com/eli/gr/const/1975/art/44/genesis> a prov:Activity, slw:OriginAssertion ;
    rdfs:label "Article 44 Genesis Event"@en ;
    prov:startedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    slw:blockchainAnchor "pending" ;
    slw:blockchainIsNotAuthority true ;
    prov:wasAssociatedWith <https://stavropouloslaw.com/identity/org> ;
    rdfs:comment """Genesis event for Article 44. Blockchain anchor serves
        as timestamp witness, NOT as truth authority."""@en .

