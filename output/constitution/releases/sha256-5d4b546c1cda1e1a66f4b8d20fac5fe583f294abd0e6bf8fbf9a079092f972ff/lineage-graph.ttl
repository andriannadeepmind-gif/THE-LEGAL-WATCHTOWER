# ==============================================================================
# STAVROPOULOS LAW - IDENTITY LINEAGE GRAPH
# ==============================================================================
# PURPOSE: PROV-O compliant identity continuity tracking
# STANDARD: W3C PROV-O (https://www.w3.org/TR/prov-o/)
# TEMPORAL PROOF: Blockchain + RFC 3161
# ==============================================================================

<https://stavropouloslaw.com/lineage/2025> a prov:Collection ;
    dcterms:title "Greek Constitution Identity Lineage Graph"@en ;
    dcterms:created "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    dcterms:creator <https://stavropouloslaw.com/identity/org> ;
    slw:totalArticles 124 ;
    rdfs:comment """PROV-O lineage graph tracking identity
        continuity of all articles. Each article has genesis event with
        blockchain-backed timestamp."""@en .

# === Article 1 Genesis ===

<https://stavropouloslaw.com/eli/gr/const/1975/art/1> a prov:Entity, slw:LegalArticleIdentity ;
    rdfs:label "Article 1 Identity"@en ;
    prov:wasGeneratedBy <https://stavropouloslaw.com/eli/gr/const/1975/art/1/genesis> ;
    slw:identityHash "NIL" ;
    slw:genesisProof "pending" ;
    dcterms:identifier <https://stavropouloslaw.com/eli/gr/const/1975/art/1> .

<https://stavropouloslaw.com/eli/gr/const/1975/art/1/genesis> a prov:Activity, slw:OriginAssertion ;
    rdfs:label "Article 1 Genesis Event"@en ;
    prov:startedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-09T00:00:00Z"^^xsd:dateTime ;
    slw:blockchainAnchor "pending" ;
    slw:blockchainIsNotAuthority true ;
    prov:wasAssociatedWith <https://stavropouloslaw.com/identity/org> ;
    rdfs:comment """Genesis event for Article 1. Blockchain anchor serves
        as timestamp witness, NOT as truth authority."""@en .

