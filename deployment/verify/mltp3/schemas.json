      "qualification_policy_version",
      "min_verifier_version",
      "activation",
      "expiry",
      "revoked",
      "owner_kid",
      "sig"
    ],
    "expected_profile_id": "mltp3-executable-reference/1",
    "verifier_version": "1"
  }
