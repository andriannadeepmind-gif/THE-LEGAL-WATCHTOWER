{
  "schema": "mltp3-executable-reference/1",
  "note": "Shared, immutable contract read by BOTH independent verifiers (Go, Node) and the builder. Verifiers share ONLY this file plus the fixtures — never verification code. This is the corrected, ACYCLIC MLTP v3 core: no object embeds its own id in its preimage; time and release/inclusion are DETACHED (see construction_order).",
  "canonical": {
    "spec": "deployment/verify/canonical-serialization-spec.md",
    "rules": "RFC 8785 JCS: sorted keys by code point, no whitespace, integers only, NO booleans in hash-bearing records (encode as string enums), NFC/LF for legal text",
    "hash": "sha256(UTF-8(canonical-json(record)))",
    "compose_separator": "0x1F"
  },
  "id_domains": {
    "clm1:": "mltp3:claim-id",
    "res1:": "mltp3:result-id",
    "qsr1:": "mltp3:qsr-id",
    "bnd1:": "mltp3:bundle-id"
  },
  "id_rule": "each *_id = prefix + hex(sha256(id_domain 0x1F canonical(BODY))) where BODY EXCLUDES the id, the signature, any detached time attestation, any release_root, and any inclusion proof. An id that appears in its own preimage is a self-referential-id defect.",
  "sig_contexts": [
    "mltp3:issued-claim",
    "mltp3:delegation",
    "mltp3:revocation",
    "mltp3:registry-snapshot",
    "mltp3:release-root",
    "mltp3:time-attestation",
    "mltp3:witness-checkpoint",
    "mltp3:qual-state",
    "mltp3:reviewer-adoption",
    "mltp3:provider-attestation",
    "mltp3:provider-conformance",
    "mltp3:compiler-attestation",
    "mltp3:cockpit-intent",
    "mltp3:certified-result",
    "mltp3:citation",
    "mltp3:profile-manifest"
  ],
  "sig_rule": "sig = Ed25519(secret, context 0x1F canonical(object without its own sig field)). Wrong context => sig-invalid (domain-separation replay defence).",
  "claim_types": [
    "source-authenticity",
    "legal-state",
    "temporal-projection",
    "coverage-and-freshness",
    "judgment-identity-and-text",
    "jurisprudential-analysis",
    "legal-object-correction-or-withdrawal",
    "normative-impact-projection"
  ],
  "legal_relation_verbs": {
    "parser_certifiable": [
      "cites"
    ],
    "reviewer_adoption_required": [
      "followed",
      "applied",
      "distinguished",
      "overruled",
      "doubted",
      "limited"
    ],
    "note": "correction #15: a deterministic parser certifies only structural `cites`. Treatment verbs need anchored evidence + reviewer adoption, or an authentic official structured disposition."
  },
  "crypto": {
    "signature": "Ed25519 (RFC 8032), strict verification",
    "builder_backend": "libsodium 1.0.18 (soname libsodium.so.23, ABI 10.3), via ctypes — real version from sodium_version_string(), not the soname",
    "verifier_a_backend": "Go stdlib crypto/ed25519 (pure Go, filippo edwards25519 — NOT OpenSSL)",
    "verifier_b_backend": "Node built-in node:crypto (OpenSSL 3.5.5)",
    "independence": "the two VERIFIERS use genuinely different vetted backends (pure-Go crypto/ed25519 vs Node/OpenSSL); the BUILDER signs with a third (libsodium). No homemade primitive is in any trusted path. Go and Node are two independent N-version IMPLEMENTATIONS from one specification — NOT an independent organizational audit.",
    "unavailable_result": "CRYPTO_BACKEND_UNAVAILABLE",
    "rfc_anchor": {
      "vector": "RFC 8032 §7.1 TEST 2",
      "seed": "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
      "public": "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
      "msg": "72",
      "sig": "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
    },
    "thumbprint": "kid = RFC 7638 JWK thumbprint = base64url(sha256('{\"crv\":\"Ed25519\",\"kty\":\"OKP\",\"x\":\"<b64url pub>\"}'))"
  },
  "merkle": {
    "profile": "lawmax-merkle-sha256-v1 (RFC 9162 §2.1.1)",
    "leaf": "sha256: + hex(sha256(0x00 || data))",
    "node": "sha256: + hex(sha256(0x01 || raw(a) || raw(b)))",
    "unbalanced": "split at largest power of two < n; NO duplicate-last",
    "release_leaf_data": "UTF-8 bytes of the claim_id string, leaves ordered by ascending claim_id"
  },
  "time_attestation": {
    "note": "DETACHED (correction #2): signs the message-imprint of an object's signature, never sits inside the object's signed fields. This is a deterministic TEST DOUBLE of an RFC 3161 TSR with the SAME verification contract — it is NOT an actual TSR. A real DER RFC-3161 token (OpenSSL ts) lives in interop/rfc3161/token.tsr (C1.4).",
    "fields": [
      "attests_context",
      "target_sig_imprint",
      "gen_time",
      "accuracy_seconds",
      "tsa_kid",
      "sig"
    ],
    "rfc3161_semantics": "correction #10: gen_time is trusted evidence the imprint existed AT-OR-BEFORE (gen_time + accuracy). t_sig upper bound = gen_time + accuracy; the signing key's delegation window is checked conservatively against this bound.",
    "imprint": "target_sig_imprint = sha256(hex) of the raw 64-byte signature bytes of the attested object"
  },
  "result_order": [
    "UNVERIFIED_FOR_MACHINE_RELIANCE",
    "UNVERIFIED_FOR_ATTRIBUTED_RELIANCE",
    "UNKNOWN",
    "VERIFIED"
  ],
  "result_rule": "bundle result = min over all claim results, certified-result results, and bundle-level checks, by result_order (lower index = weaker).",
  "error_taxonomy": {
    "malformed-envelope": "UNVERIFIED_FOR_MACHINE_RELIANCE",
