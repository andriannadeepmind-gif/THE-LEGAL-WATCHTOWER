  },
  "construction_order": [
    {
      "step": 1,
      "node": "ClaimBody",
      "preimage_excludes": [
        "claim_id",
        "signature",
        "time_attestation",
        "release_root",
        "inclusion_proof"
      ]
    },
    {
      "step": 2,
      "node": "claim_id",
      "derives_from": [
        "ClaimBody"
      ]
    },
    {
      "step": 3,
      "node": "SignedClaim.signature",
      "derives_from": [
        "claim_id",
        "ClaimBody",
        "signer"
      ]
    },
    {
      "step": 4,
      "node": "TimeAttestation(claim)",
      "derives_from": [
        "SignedClaim.signature"
      ]
    },
    {
      "step": 5,
      "node": "coverage-and-freshness claim",
      "derives_from": [
        "corpus",
        "known_time"
      ]
    },
    {
      "step": 6,
      "node": "ReleaseManifest",
      "derives_from": [
        "sorted claim_ids"
      ]
    },
    {
      "step": 7,
      "node": "release_root + ReleaseAttestation",
      "derives_from": [
        "ReleaseManifest"
      ]
    },
    {
      "step": 8,
      "node": "InclusionProof(claim_id)",
      "derives_from": [
        "claim_id",
        "release_root"
      ]
    },
    {
      "step": 9,
      "node": "CertifiedResultBody",
      "derives_from": [
        "claim_ids",
        "release_root",
        "coverage_ref",
        "citation"
      ]
    },
    {
      "step": 10,
      "node": "result_id",
      "derives_from": [
        "CertifiedResultBody"
      ]
    },
    {
      "step": 11,
      "node": "CertifiedResult.signature + TimeAttestation(result) + CitationToken",
      "derives_from": [
        "result_id",
        "CertifiedResultBody"
      ]
    },
    {
      "step": 12,
      "node": "compiler attestations / provider conformance / QSR",
      "derives_from": [
        "release_root"
      ]
    },
    {
      "step": 13,
      "node": "RevocationCheckpoint",
      "derives_from": [
        "revocations",
        "witnesses"
      ]
    },
    {
      "step": 14,
      "node": "BundleManifest -> bundle_id",
      "derives_from": [
        "all artifact ids and digests (never bundle_id)"
      ]
    }
  ],
  "dag_rule": "every reference points to an object earlier in construction_order; no back edge; no node contains its own id in its preimage. dag_check.py verifies this mechanically over the fixtures.",
  "profile_manifest": {
    "note": "C1.1: signed manifest pinning the verification profile. Both verifiers reject a changed/downgraded/unknown schema or profile with untrusted-profile. Dev override (env MLTP_DEV_OVERRIDE=1) may proceed but NEVER returns VERIFIED (caps at UNKNOWN, reason profile-override-active).",
    "context": "mltp3:profile-manifest",
    "fields": [
      "profile_id",
      "schemas_sha256",
      "canonicalization_profile",
      "signature_contexts_digest",
      "id_domains_digest",
      "merkle_profile",
