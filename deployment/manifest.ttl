@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ==============================================================================
# DCAT-AP 2.1.1 MANIFEST
# Greek Constitution Semantic Corpus
# ==============================================================================
# Generated: 2025-11-13T20:00:00Z
# Version: 1.2.0
# Standard: DCAT-AP 2.1.1
# ==============================================================================

<https://stavropouloslaw.com/eli/gr/const> a dcat:Dataset, eli:LegalResource, void:Dataset ;
    
    # Title (Multilingual)
    dcterms:title "Greek Constitution Semantic Corpus"@en ;
    dcterms:title "Σημασιολογικό Σώμα του Ελληνικού Συντάγματος"@el ;
    
    # Description
    dcterms:description """
        Complete semantic corpus of the Constitution of Greece (1975, as amended).
        This dataset provides machine-readable RDF representations of all 120 articles,
        with blockchain anchoring, qualified electronic signatures, and AI optimization.
        
        Key features:
        - RDF/Turtle + JSON-LD formats
        - ELI (European Legislation Identifier) compliant
        - SHACL validated
        - Blake3 hashed
        - Triple blockchain anchored (Ethereum, Arweave, IPFS)
        - QES signed
        - AI-optimized HTML with Schema.org markup
    """@en ;
    
    dcterms:description """
        Πλήρες σημασιολογικό σώμα του Συντάγματος της Ελλάδας (1975, όπως τροποποιήθηκε).
        Αυτό το dataset παρέχει machine-readable RDF αναπαραστάσεις όλων των 120 άρθρων,
        με αγκύρωση blockchain, εγκεκριμένες ηλεκτρονικές υπογραφές και βελτιστοποίηση AI.
    """@el ;
    
    # Identifier
    dcterms:identifier "eli-gr-const-2025" ;
    adms:identifier [
        a adms:Identifier ;
        skos:notation "https://stavropouloslaw.com/eli/gr/const" ;
        adms:schemeAgency "STAVROPOULOS LAW"
    ] ;
    
    # Creator & Publisher
    dcterms:creator <https://stavropouloslaw.com/#me> ;
    dcterms:publisher <https://stavropouloslaw.com/#organization> ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "STAVROPOULOS LAW" ;
        vcard:hasEmail <mailto:info@stavropouloslaw.com> ;
        vcard:hasURL <https://stavropouloslaw.com>
    ] ;
    
    # Dates
    dcterms:created "2025-11-13T00:00:00Z"^^xsd:dateTime ;
    dcterms:issued "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    
    # Language & Coverage
    dcterms:language <http://publications.europa.eu/resource/authority/language/ELL> ;
    dcterms:spatial <http://publications.europa.eu/resource/authority/country/GRC> ;
    dcterms:temporal [
        a dcterms:PeriodOfTime ;
        schema:startDate "1975-06-11"^^xsd:date ;
        schema:endDate "2025-11-13"^^xsd:date
    ] ;
    
    # Subject & Keywords
    dcat:theme <http://eurovoc.europa.eu/1043> ;  # Constitutional law
    dcat:keyword "Constitution"@en, "Constitutional Law"@en, "Greek Law"@en ;
    dcat:keyword "Σύνταγμα"@el, "Συνταγματικό Δίκαιο"@el, "Ελληνικό Δίκαιο"@el ;
    
    # Legal Source
    eli:legal_source <http://www.hellenicparliament.gr/constitution> ;
    prov:hadPrimarySource <http://www.et.gr> ;
    prov:wasDerivedFrom <http://www.hellenicparliament.gr/constitution> ;
    
    # Distributions
    dcat:distribution <#dist-rdf-turtle>,
                     <#dist-rdf-jsonld>,
                     <#dist-html>,
                     <#dist-sparql> ;
    
    # Dataset Parts (120 articles)
    # NOTE: In production, this would list all 120 articles
    # For brevity, showing pattern for first 3 articles
    dcat:hasPart <https://stavropouloslaw.com/eli/gr/const/1975-06-11/article-1>,
                 <https://stavropouloslaw.com/eli/gr/const/1975-06-11/article-2>,
                 <https://stavropouloslaw.com/eli/gr/const/1975-06-11/article-3> ;
    # ... (articles 4-120 would be listed here)
    
    # Provenance
    prov:wasGeneratedBy <#corpus-creation-activity> ;
    prov:wasAttributedTo <https://stavropouloslaw.com/#me> ;
    
    # Quality & Standards
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcterms:relation <http://data.europa.eu/eli/ontology> ;
        dcat:hadRole <http://www.w3.org/ns/dcat#standard>
    ] ;
    
    # Blockchain Anchoring
    schema:verifiableCredential [
        a schema:DigitalDocument ;
        schema:name "Blockchain Proof" ;
        schema:url <https://etherscan.io/tx/0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb7> ;
        schema:encodingFormat "blockchain-proof"
    ] ;
    
    # License
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "© 2025 STAVROPOULOS LAW. Licensed under CC BY 4.0"@en ;
    
    # Access Rights
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    
    # Statistics
    void:triples 15000 ;
    void:entities 120 ;
    void:classes 25 ;
    void:properties 150 ;
    
    # Conformance
    dcterms:conformsTo <http://data.europa.eu/eli/ontology>,
                       <http://www.w3.org/TR/vocab-dcat-2/>,
                       <https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/211> .

# ==============================================================================
# DISTRIBUTIONS
# ==============================================================================

<#dist-rdf-turtle> a dcat:Distribution ;
    dcterms:title "RDF Turtle Distribution"@en ;
    dcterms:description "Complete corpus in RDF/Turtle format"@en ;
    dcat:accessURL <https://stavropouloslaw.com/eli/gr/const/download/turtle> ;
    dcat:downloadURL <https://stavropouloslaw.com/eli/gr/const/complete.ttl> ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dcat:mediaType "text/turtle" ;
    dcat:byteSize "5242880"^^xsd:decimal ;
    dcterms:issued "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    adms:status <http://purl.org/adms/status/Completed> .

<#dist-rdf-jsonld> a dcat:Distribution ;
    dcterms:title "JSON-LD Distribution"@en ;
    dcterms:description "Complete corpus in JSON-LD format"@en ;
    dcat:accessURL <https://stavropouloslaw.com/eli/gr/const/download/jsonld> ;
    dcat:downloadURL <https://stavropouloslaw.com/eli/gr/const/complete.jsonld> ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/JSON_LD> ;
    dcat:mediaType "application/ld+json" ;
    dcat:byteSize "7340032"^^xsd:decimal ;
    dcterms:issued "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    adms:status <http://purl.org/adms/status/Completed> .

<#dist-html> a dcat:Distribution ;
    dcterms:title "AI-Optimized HTML Distribution"@en ;
    dcterms:description "Human-readable HTML with embedded RDFa and Schema.org markup"@en ;
    dcat:accessURL <https://stavropouloslaw.com/eli/gr/const> ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/HTML> ;
    dcat:mediaType "text/html" ;
    dcterms:issued "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    adms:status <http://purl.org/adms/status/Completed> .

<#dist-sparql> a dcat:Distribution ;
    dcterms:title "SPARQL Endpoint"@en ;
    dcterms:description "Query interface for the semantic corpus"@en ;
    dcat:accessURL <https://stavropouloslaw.com/sparql> ;
    dcat:accessService <#sparql-service> ;
    dcterms:format <http://www.w3.org/ns/formats/SPARQL_Results_JSON> ;
    adms:status <http://purl.org/adms/status/Completed> .

<#sparql-service> a dcat:DataService ;
    dcterms:title "SPARQL Query Service"@en ;
    dcat:endpointURL <https://stavropouloslaw.com/sparql> ;
    dcat:servesDataset <https://stavropouloslaw.com/eli/gr/const> .

# ==============================================================================
# PROVENANCE ACTIVITY
# ==============================================================================

<#corpus-creation-activity> a prov:Activity ;
    rdfs:label "Greek Constitution Semantic Corpus Creation"@en ;
    prov:startedAtTime "2019-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://stavropouloslaw.com/#me> ;
    prov:used <http://www.hellenicparliament.gr/constitution> ;
    prov:generated <https://stavropouloslaw.com/eli/gr/const> ;
    
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent <https://stavropouloslaw.com/#me> ;
        prov:hadRole <http://www.w3.org/ns/prov#Creator>
    ] .

# ==============================================================================
# CATALOG ENTRY
# ==============================================================================

<https://stavropouloslaw.com/catalog> a dcat:Catalog ;
    dcterms:title "STAVROPOULOS LAW Legal Corpus Catalog"@en ;
    dcterms:description "Catalog of semantic legal corpora published by STAVROPOULOS LAW"@en ;
    dcterms:publisher <https://stavropouloslaw.com/#organization> ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ELL> ;
    dcat:dataset <https://stavropouloslaw.com/eli/gr/const> ;
    dcterms:issued "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2025-11-13T20:00:00Z"^^xsd:dateTime ;
    foaf:homepage <https://stavropouloslaw.com> .

