,"article":"746","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"}],"source_file":"/app/input/decisions/areios-pagos/ap_2026_58.txt","penal":false,"act_date":"1996-12-23","act_date_evidence":" άρθρο 44 του Ν. 1892/1990, η από 23-12-1996 συμφωνία περί περιορισμού και ρύθμι"}