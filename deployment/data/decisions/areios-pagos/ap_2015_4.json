έσα στο οποίο αυτές γεννήθηκαν, και όχι από τη γένεση εκάστης περιοδικής εξ αυτών παροχής, και δη από το τέλος κάθε μήνα, από το οποίο ήταν καταβλητέα εκάστη, παραβίασε τις ουσιαστικού δικαίου διατάξεις των άρθρων 90 παρ.","grounds":[{"vehicle":"ΚΠολΔ 559","ordinal":2,"kind":"ruling","verdict":"accepted","excerpt":"… συνέτρεχαν οι προς τούτο προϋποθέσεις, του δε δευτέρου με το να το εφαρμόσει, ενώ δεν έπρεπε, και υπέπεσε στην πλημμέλεια από τον αριθμό 1 του άρθρου 559 Κ.Πολ.Δ., όπως βάσιμα υποστηρίζει το αναιρεσείον με τον παραπεμφθέντα δεύτερο λόγο του αναιρετηρίου, ο οποίος συνακόλουθα πρέπει να γίνει δεκτός.","start":8797,"end":9546}],"citations":[{"law":"ΚΠολΔ","law_inferred":false,"article":"242","paragraph":"2","corpus":"kpolitikis","article_exists":true,"article_date":"01/01/2022","tempus_verdict":"amended-after","act_verdict":"amended-after-judgment"},{"law":"ΚΠολΔ","law_inferred":true,"article":"559","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"01/01/2002","tempus_verdict":"same-text-proven","act_verdict":"amended-since-act"},{"law":"ν. 1756/1988","law_inferred":false,"article":"23","paragraph":"2"},{"law":"ν. 3659/2008","law_inferred":false,"article":"44","paragraph":null},{"law":"ΚΠολΔ","law_inferred":true,"article":"563","paragraph":"3","corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ν. 2362/1995","law_inferred":false,"article":"90","paragraph":"3"},{"law":null,"law_inferred":false,"article":"91","paragraph":null},{"law":"ΑΚ","law_inferred":true,"article":"250","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"Σ","law_inferred":true,"article":"4","paragraph":null,"corpus":"syntagma","article_exists":false,"article_date":null,"tempus_verdict":"unknown"},{"law":"Σ","law_inferred":true,"article":"20","paragraph":null,