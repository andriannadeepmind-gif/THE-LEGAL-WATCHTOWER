ts":true,"article_date":"01/01/2002","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":false,"article":"561","paragraph":"1","corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":false,"article":"562","paragraph":"2","corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΑΚ","law_inferred":false,"article":"977","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΑΚ","law_inferred":true,"article":"853","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"Ν. 4014/2011","law_inferred":true,"article":"24","paragraph":null},{"law":null,"law_inferred":false,"article":"6","paragraph":null},{"law":null,"law_inferred":false,"article":"11","paragraph":null},{"law":null,"law_inferred":false,"article":"5","paragraph":null},{"law":"ΑΚ","law_inferred":true,"article":"577","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΑΚ","law_inferred":true,"article":"575","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ν. 4276/2014","law_inferred":false,"article":"3","paragraph":null},{"law":"Ν. 4178/2013","law_inferred":false,"article":"11","paragraph":null},{"law":"Ν. 4276/2014","law_inferred":false,"article":"3","paragraph":null},{"law":"ΚΠολΔ","law_inferred":true,"article":"562","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":true,"article":"335","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":false,"article":"529","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"01/01/2002","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":null,"law_inferred":false,"article":"339","paragraph":null},{"law":null,"law_inferred":false,"article":"561","paragraph":"1"},{"law":"ΚΠολΔ","law_inferred":true,"article":"339","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"25/07/2011","tempus_verdict":"same-text-proven","act_verdict":"amended-since-act"},{"law":"ν. 4178/2013","law_inferred":false,"article":"11","paragraph":null},{"law":"ΚΠολΔ","law_inferred":false,"article":"495","paragraph":"3","corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":true,"article":"176","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"24/10/1985","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"}],"source_file":"/app/input/decisions/areios-pagos/ap_2026_86.txt","penal":false,"act_date":"2010-06-22","act_date_evidence":"Επιμελητήριο της Ελλάδας, τις από 22-6-2010 και από 30-5-2011 Υπεύθυνες Δηλώσεις"}