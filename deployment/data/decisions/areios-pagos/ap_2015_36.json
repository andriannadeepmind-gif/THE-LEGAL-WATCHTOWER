{"court":"areios-pagos","number":"36","year":"2015","chamber":"Δ΄ Πολιτικό Τμήμα","summary":null,"judges":[{"name":"Δημητρούλα Υφαντή","role":"Αρεοπαγίτης","rapporteur":false},{"name":"Γεώργιο Σακκά","role":"Αρεοπαγίτης","rapporteur":false},{"name":"Παναγιώτη Χατζηπαναγιώτη","role":"Αρεοπαγίτης","rapporteur":false},{"name":"Χαράλαμπο Καλαματιανό","role":"Αρεοπαγίτης","rapporteur":false}],"operative":["Απορρίπτει","Καταδικάζει"],"structure":[{"section":"header","start":0,"end":417},{"section":"parties","start":417,"end":834},{"section":"history","start":834,"end":1696},{"section":"reasoning","start":1696,"end":14423},{"section":"operative","start":14423,"end":15007}],"ratio_evidence":null,"grounds":[{"vehicle":"ΚΠολΔ 559","ordinal":null,"kind":"petition","verdict":"unfounded","excerpt":"Συνεπώς, ο πρώτος κατά σειρά λόγος της υπό κρίση αίτησης αναίρεσης, κατά το μέρος του από τον αριθμό 19 του άρθρου 559 Κ.Πολ.Δ., με τον οποίο υποστηρίζονται τα αντίθετα, είναι αβάσιμος και απορριπτέος.","start":11651,"end":11854},{"vehicle":"ΚΠολΔ 559 αρ.11","ordinal":null,"kind":"ruling","verdict":"unfounded","excerpt":"…του Κ.Πολ.Δ. λόγος αναίρεσης, ιδρυόμενος αν το δικαστήριο δεν έλαβε υπόψη αποδεικτικά μέσα που οι διάδικοι επικαλέσθηκαν και προσκόμισαν, είναι απορριπτέος ως αβάσιμος αν προκύπτει από την προσβαλλόμενη απόφαση ότι λήφθηκαν υπόψη όλα τα αποδεικτικά μέσα που οι διάδικοι επικαλέσθηκαν και προσκόμισαν.","start":13018,"end":13351},{"vehicle":null,"ordinal":null,"kind":"ruling","verdict":"unfounded","excerpt":"11γ' του Κ.Πολ.Δ., δεύτερος κατά σειρά και τελευταίος λόγος της αναίρεσης είναι αβάσιμος και απορριπτέος.","start":14019,"end":14125}],"citations":[{"law":"ΚΠολΔ","law_inferred":false,"article":"242","paragraph":"2","corpus":"kpolitikis","article_exists":true,"article_date":"01/01/2022","tempus_verdict":"amended-after","act_verdict":"amended-after-judgment"},{"law":"ΑΚ","law_inferred":true,"article":"297","paragraph":null,"corpus":"astikos","article_exists":true,"article_date":"23/02/1946","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"},{"law":"ΚΠολΔ","law_inferred":true,"article":"559","paragraph":null,"corpus":"kpolitikis","article_exists":true,"article_date":"01/01/2002","tempus_verdict":"same-text-proven","act_verdict":"same-since-act"}],"source_file":"/app/input/decisions/areios-pagos/ap_2015_36.txt","penal":false,"act_date":"2002-08-23","act_date_evidence":"χνικό έλεγχο της μοτοσυκλέτας στις 23.8.2002, απεφάνθη, ότι όλα τα συστήματα της"}