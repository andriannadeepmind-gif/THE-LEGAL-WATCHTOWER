# ==============================================================================
# FAILURE ANALYSIS (Q3 2025)
# ==============================================================================

feedback:failure-analysis-q3-2025 a infra:FailureAnalysis ;
    rdfs:label "Citation Failure Analysis - Q3 2025"@en ;
    
    infra:totalFailures 120 ;
    infra:failureRate "2.8%"^^xsd:float ;
    
    # Breakdown by failure type
    infra:failuresByType [
        infra:type "AMBIGUOUS_REFERENCE"@en ;
        infra:count 47 ;
        infra:percentage "39.2%"^^xsd:float ;
        infra:description "Query referenced law without specifying article"@en
    ] ;
    infra:failuresByType [
        infra:type "OUTDATED_REFERENCE"@en ;
        infra:count 28 ;
        infra:percentage "23.3%"^^xsd:float ;
        infra:description "Referenced repealed or amended provision"@en
    ] ;
    infra:failuresByType [
        infra:type "INCORRECT_DOMAIN"@en ;
        infra:count 19 ;
        infra:percentage "15.8%"^^xsd:float ;
        infra:description "Cited article from wrong legal domain"@en
    ] ;
    infra:failuresByType [
        infra:type "MALFORMED_QUERY"@en ;
        infra:count 15 ;
        infra:percentage "12.5%"^^xsd:float ;
        infra:description "Query syntax errors or invalid ELI identifiers"@en
    ] ;
    infra:failuresByType [
        infra:type "RATE_LIMIT_EXCEEDED"@en ;
        infra:count 11 ;
        infra:percentage "9.2%"^^xsd:float ;
        infra:description "AI system exceeded query rate limits"@en
    ] ;
    
    # Resolution statistics
    infra:resolvedFailures 97 ;
    infra:resolutionRate "80.8%"^^xsd:float ;
    infra:averageResolutionTime "PT2H15M"^^xsd:duration ;
    infra:unresolvedFailures 23 ;
    
    # Improvements implemented
    infra:improvementsImplemented [
        infra:improvement "Enhanced disambiguation metadata on law landing pages"@en ;
        infra:affectedFailureType "AMBIGUOUS_REFERENCE"@en ;
        infra:reductionRate "68%"^^xsd:float
    ] ;
    infra:improvementsImplemented [
        infra:improvement "Added repeal/amendment warnings to article pages"@en ;
        infra:affectedFailureType "OUTDATED_REFERENCE"@en ;
        infra:reductionRate "82%"^^xsd:float
    ] ;
    infra:improvementsImplemented [
        infra:improvement "Implemented automatic domain classification"@en ;
        infra:affectedFailureType "INCORRECT_DOMAIN"@en ;
        infra:reductionRate "45%"^^xsd:float
    ] .

