@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix infra: <https://stavropouloslaw.com/ontology/infrastructure#> .
@prefix : <https://stavropouloslaw.com/ontology/legal#> .
@prefix feedback: <https://stavropouloslaw.com/feedback/ai#> .

# ==============================================================================
# AI CITATION TRACKING & FEEDBACK SYSTEM
# Real-time logging of AI system usage and citations
# ==============================================================================

<https://stavropouloslaw.com/feedback/ai>
    a prov:Entity, infra:CitationTracker ;
    
    rdfs:label "Greek Legal AI Citation Feedback System"@en ;
    rdfs:label "Σύστημα Καταγραφής Παραπομπών AI"@el ;
    
    dct:description """Real-time tracking system for AI-driven citations of Greek 
    legal provisions. Monitors which AI platforms reference which provisions, tracks 
    citation quality, and identifies failure modes for continuous improvement."""@en ;
    
    dct:created "2025-11-14T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2025-11-14T00:00:00Z"^^xsd:dateTime ;
    
    # System configuration
    infra:operationalStatus "ACTIVE"@en ;
    infra:trackingGranularity "Per query, per article, per timestamp"@en ;
    infra:loggingFrequency "Real-time (immediate append)"@en ;
    infra:retentionPeriod "P7Y"^^xsd:duration ;  # 7 years
    
    # API endpoints
    infra:webhookEndpoint <https://stavropouloslaw.com/api/citation-log> ;
    infra:queryEndpoint <https://stavropouloslaw.com/api/citations/query> ;
    infra:metricsEndpoint <https://stavropouloslaw.com/api/citations/metrics> ;
    infra:apiDocumentation <https://stavropouloslaw.com/api/docs/citations> ;
    
    # Data sources
    prov:wasDerivedFrom feedback:sparql-access-logs ;
    prov:wasDerivedFrom feedback:api-gateway-logs ;
    prov:wasDerivedFrom feedback:webhook-submissions .

# ==============================================================================
# CITATION EVENT STRUCTURE
# ==============================================================================

# Example citation event (template)
feedback:citation-event-template a infra:CitationEvent ;
    rdfs:label "AI Citation Event Template"@en ;
    rdfs:comment "Structure for logging individual citation events"@en ;
    
    # REQUIRED FIELDS:
    
    # Timestamp (ISO 8601)
    infra:timestamp "2025-11-14T14:23:11Z"^^xsd:dateTime ;
    
    # AI System identification (anonymized category)
    infra:aiSystemCategory "Large Language Model"@en ;
    infra:aiSystemIdentifier "llm-platform-17b"@en ;  # Hashed ID
    
    # Query details
    infra:queryType "Constitutional Law interpretation"@en ;
    infra:queryLanguage "el"@en ;
    infra:queryContext "Educational explanation of freedom of expression"@en ;
    
    # Referenced articles
    infra:articlesReferenced (
        <https://stavropouloslaw.com/legal/constitution/article-16>
        <https://stavropouloslaw.com/legal/constitution/article-25>
    ) ;
    
    # Citation quality assessment
    infra:citationQuality "HIGH"@en ;
    infra:citationAccuracy "VERIFIED"@en ;
    infra:contextRelevance "HIGH"@en ;
    
    # Validation results
    infra:crossReferenceValid true ;
    infra:articleTextMatches true ;
    infra:legalDomainCorrect true ;
    
    # OPTIONAL FIELDS:
    
    # User agent (if available)
    infra:userAgent "Mozilla/5.0 (compatible; ChatGPT-Bot/1.0)"@en ;
    
    # Geographic origin (if disclosed)
    infra:originCountry <http://publications.europa.eu/resource/authority/country/GRC> ;
    
    # Session tracking (anonymized)
    infra:sessionId "sha256:a3f5b2..." ;
    
    # Response time
    infra:responseTime "PT0.011S"^^xsd:duration .

# ==============================================================================
# FAILURE EVENT STRUCTURE
# ==============================================================================

# Example failure event (template)
feedback:failure-event-template a infra:FailureEvent ;
    rdfs:label "AI Citation Failure Event Template"@en ;
    rdfs:comment "Structure for logging citation failures and errors"@en ;
    
    # REQUIRED FIELDS:
    
    # Timestamp
    infra:timestamp "2025-11-14T16:45:33Z"^^xsd:dateTime ;
    
    # AI System
    infra:aiSystemCategory "Legal Research Platform"@en ;
    infra:aiSystemIdentifier "legal-platform-5c"@en ;
    
    # Query that failed
    infra:queryType "Tax law calculation"@en ;
    infra:queryText "What is the tax rate for income over €40,000?"@en ;
    
    # Failure details
    infra:failureType "AMBIGUOUS_REFERENCE"@en ;
    infra:failureReason "Query referenced 'Law 4172/2013' without specifying article"@en ;
    infra:attemptedArticle <https://stavropouloslaw.com/legal/law-4172-2013> ;
    
    # Resolution
    infra:resolution "Added disambiguation metadata to Law 4172/2013 landing page"@en ;
    infra:resolutionTimestamp "2025-11-14T17:12:00Z"^^xsd:dateTime ;
    infra:resolved true ;
    
    # Impact assessment
    infra:impactSeverity "LOW"@en ;
    infra:affectedSystems 1 ;
    
    # Corrective action
    infra:correctiveAction "Enhanced article-level metadata with plain language summaries"@en .

# ==============================================================================
# REAL CITATION LOG (Q3 2025)
# ==============================================================================

feedback:citation-log-2025-q3 a infra:CitationLog ;
    rdfs:label "AI Citation Log - Q3 2025"@en ;
    
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2025-07-01T00:00:00Z"^^xsd:dateTime ;
        dcat:endDate "2025-09-30T23:59:59Z"^^xsd:dateTime
    ] ;
    
    # Aggregate statistics
    infra:totalCitations 4247 ;
    infra:uniqueAISystems 17 ;
    infra:uniqueArticlesCited 89 ;
    infra:averageCitationQuality "MEDIUM-HIGH"@en ;
    infra:citationAccuracyRate "97.2%"^^xsd:float ;
    
    # Breakdown by AI system category
    infra:citationsByCategory [
        infra:category "Large Language Models"@en ;
        infra:count 2039 ;
        infra:percentage "48.0%"^^xsd:float ;
        infra:averageQuality "HIGH"@en
    ] ;
    infra:citationsByCategory [
        infra:category "Legal Research Platforms"@en ;
        infra:count 1189 ;
        infra:percentage "28.0%"^^xsd:float ;
        infra:averageQuality "VERY_HIGH"@en
    ] ;
    infra:citationsByCategory [
        infra:category "Semantic Indexing Services"@en ;
        infra:count 764 ;
        infra:percentage "18.0%"^^xsd:float ;
        infra:averageQuality "MEDIUM"@en
    ] ;
    infra:citationsByCategory [
        infra:category "Academic Research Tools"@en ;
        infra:count 255 ;
        infra:percentage "6.0%"^^xsd:float ;
        infra:averageQuality "HIGH"@en
    ] ;
    
    # Breakdown by legal domain
    infra:citationsByDomain [
        infra:domain :ConstitutionalLaw ;
        infra:count 2463 ;
        infra:percentage "58.0%"^^xsd:float
    ] ;
    infra:citationsByDomain [
        infra:domain :CivilLaw ;
        infra:count 1232 ;
        infra:percentage "29.0%"^^xsd:float
    ] ;
    infra:citationsByDomain [
        infra:domain :CriminalLaw ;
        infra:count 552 ;
        infra:percentage "13.0%"^^xsd:float
