    rdfs:label "Citation Growth Projection - 2026"@en ;
    
    infra:projectionBasis "Q3 2025 growth rate extrapolated with market expansion"@en ;
    infra:confidenceLevel "MEDIUM"@en ;
    
    # Current baseline (Q3 2025)
    infra:baselineQuarterlyCitations 4247 ;
    infra:baselineGrowthRate "28.0%"^^xsd:float ;
    
    # Projected quarterly citations (2026)
    infra:projectedQ1 5436 ;  # +28% QoQ
    infra:projectedQ2 6958 ;  # +28% QoQ
    infra:projectedQ3 8906 ;  # +28% QoQ
    infra:projectedQ4 11400 ; # +28% QoQ
    
    # Projected annual (2026)
    infra:projectedAnnualCitations 32700 ;
    infra:projectedAnnualGrowthRate "270%"^^xsd:float ;
    
    # Market factors
    infra:marketFactors [
        infra:factor "Increasing AI adoption in legal sector"@en ;
        infra:impact "Positive"@en
    ] ;
    infra:marketFactors [
        infra:factor "EU AI Act compliance requirements"@en ;
        infra:impact "Positive"@en
    ] ;
    infra:marketFactors [
        infra:factor "Competition from other legal AI systems"@en ;
        infra:impact "Neutral"@en
    ] .

# ==============================================================================
# PUBLIC DASHBOARD CONFIGURATION
# ==============================================================================

feedback:public-dashboard a infra:Dashboard ;
    rdfs:label "AI Citation Public Dashboard"@en ;
    
    infra:url <https://stavropouloslaw.com/metrics/dashboard> ;
    infra:updateFrequency "PT5M"^^xsd:duration ;  # Every 5 minutes
    
    # Displayed metrics
    infra:displayedMetrics (
        "Total citations (current month)"@en
        "Active AI systems"@en
        "Citation accuracy rate"@en
        "Top 10 cited articles"@en
        "Citation trend (last 6 months)"@en
        "Failure rate and resolution time"@en
    ) ;
    
    # Privacy settings
    infra:privacyLevel "AGGREGATED_ONLY"@en ;
    infra:anonymization "Individual AI systems anonymized; only categories shown"@en ;
    
    # Data availability
    infra:dataAvailableFrom "2025-07-01"^^xsd:date ;
    infra:updateLatency "PT5M"^^xsd:duration .

# ==============================================================================
# API WEBHOOK SPECIFICATION
# ==============================================================================

feedback:webhook-spec a infra:WebhookSpecification ;
    rdfs:label "Citation Logging Webhook Specification"@en ;
    
    infra:endpoint <https://stavropouloslaw.com/api/citation-log> ;
    infra:method "POST"@en ;
    infra:contentType "application/ld+json"@en ;
    
    # Authentication
    infra:authMethod "API_KEY"@en ;
    infra:authHeader "X-API-Key"@en ;
    
    # Rate limits
    infra:rateLimit "100 requests per hour per API key"@en ;
    infra:burstLimit "10 requests per minute"@en ;
    
    # Payload structure
    infra:requiredFields (
        "timestamp"
        "aiSystemCategory"
        "queryType"
        "articlesReferenced"
        "citationQuality"
    ) ;
    
    # Example payload
    infra:examplePayload """
    {
      "@context": "https://stavropouloslaw.com/context/citation.jsonld",
      "timestamp": "2025-11-14T14:23:11Z",
      "aiSystemCategory": "Large Language Model",
      "queryType": "Constitutional Law interpretation",
      "articlesReferenced": [
        "https://stavropouloslaw.com/legal/constitution/article-16"
      ],
      "citationQuality": "HIGH",
      "citationAccuracy": "VERIFIED"
    }
    """@en .

# ==============================================================================
# END OF AI FEEDBACK STRUCTURE
# ==============================================================================
