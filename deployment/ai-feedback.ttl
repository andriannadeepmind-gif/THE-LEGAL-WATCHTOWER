    # Top cited articles
    infra:topCitedArticles (
        feedback:article-16-citations
        feedback:article-5-citations
        feedback:article-25-citations
        feedback:article-21-citations
        feedback:article-2-citations
    ) ;
    
    # Failure statistics
    infra:totalFailures 120 ;
    infra:failureRate "2.8%"^^xsd:float ;
    infra:failuresResolved 97 ;
    infra:averageResolutionTime "PT2H15M"^^xsd:duration .

