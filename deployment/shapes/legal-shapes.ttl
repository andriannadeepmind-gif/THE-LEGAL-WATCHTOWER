@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix : <https://stavropouloslaw.com/ontology/legal#> .
@prefix shapes: <https://stavropouloslaw.com/shapes/legal#> .

# ==============================================================================
# SHACL SHAPES FOR GREEK LEGAL INFRASTRUCTURE
# Validates RDF data against ontology constraints
# ==============================================================================

shapes:
    a owl:Ontology ;
    rdfs:label "Greek Legal SHACL Shapes"@en ;
    dct:description "Validation shapes for Greek legal semantic infrastructure"@en ;
    dct:created "2025-11-14"^^xsd:date .

# ==============================================================================
# LEGISLATIVE ACT SHAPES
# ==============================================================================

shapes:LegislativeActShape a sh:NodeShape ;
    sh:targetClass :LegislativeAct ;
    sh:name "Legislative Act Validation"@en ;
    sh:description "Validates all legislative acts"@en ;
    
    # REQUIRED: Every act must have a title
    sh:property [
        sh:path eli:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 5 ;
        sh:message "Every legislative act must have exactly one title (minimum 5 characters)"@en
    ] ;
    
    # REQUIRED: Publication date
    sh:property [
        sh:path eli:date_document ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Every legislative act must have exactly one publication date"@en
    ] ;
    
    # REQUIRED: Language
    sh:property [
        sh:path dct:language ;
        sh:minCount 1 ;
        sh:hasValue <http://publications.europa.eu/resource/authority/language/ELL> ;
        sh:message "Greek legislative acts must be in Greek (ELL)"@en
    ] ;
    
    # REQUIRED: Official Gazette reference
    sh:property [
        sh:path :officialGazetteNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[Α-Ω]'?\\s*\\d+" ;
        sh:message "Official Gazette number must follow format: A' 123 or Α 123"@en
    ] ;
    
    # OPTIONAL: Enacted by authority
    sh:property [
        sh:path :enactedBy ;
        sh:maxCount 1 ;
        sh:class :LegalAuthority ;
        sh:message "If present, enactedBy must reference a Legal Authority"@en
    ] ;
    
    # CONSTRAINT: Must have at least one provision
    sh:property [
        sh:path :hasProvision ;
        sh:minCount 1 ;
        sh:class :LegalProvision ;
        sh:message "Every legislative act must contain at least one provision"@en
    ] .

# ==============================================================================
# CONSTITUTION-SPECIFIC SHAPE
# ==============================================================================

shapes:ConstitutionShape a sh:NodeShape ;
    sh:targetClass :Constitution ;
    sh:name "Constitution Validation"@en ;
    
    # Must be exactly the Constitution
    sh:property [
        sh:path eli:title ;
        sh:hasValue "Σύνταγμα της Ελλάδας"@el ;
        sh:message "Constitution must have official title"@en
    ] ;
    
    # Must have articles numbered 1-120
    sh:property [
        sh:path :hasProvision ;
        sh:minCount 106 ;  # Current Greek Constitution has 106 active articles
        sh:class :ConstitutionalArticle ;
        sh:message "Constitution must have constitutional articles"@en
    ] ;
    
    # Constitutional articles must be numbered 1-120
    sh:sparql [
        sh:message "All constitutional articles must have numbers between 1 and 120"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this ?article ?number
            WHERE {
                $this a :Constitution .
                $this :hasProvision ?article .
                ?article a :ConstitutionalArticle .
                ?article :articleNumber ?number .
                FILTER (?number < 1 || ?number > 120)
            }
        """ ;
    ] .

# ==============================================================================
# LEGAL PROVISION SHAPES
# ==============================================================================

shapes:LegalProvisionShape a sh:NodeShape ;
    sh:targetClass :LegalProvision ;
    sh:name "Legal Provision Validation"@en ;
    
    # REQUIRED: Must be part of a legislative act
    sh:property [
        sh:path eli:is_part_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :LegislativeAct ;
        sh:message "Every provision must be part of exactly one legislative act"@en
    ] ;
    
    # REQUIRED: Must have legal text
    sh:property [
        sh:path :legalText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 10 ;
        sh:message "Every provision must have legal text (minimum 10 characters)"@en
    ] ;
    
    # REQUIRED: Must have title/short description
    sh:property [
        sh:path eli:title_short ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every provision must have a short title"@en
    ] ;
    
    # OPTIONAL: Legal domain classification
    sh:property [
        sh:path :belongsToDomain ;
        sh:class :LegalDomain ;
        sh:message "If present, domain must be a LegalDomain class"@en
    ] ;
    
    # CONSTRAINT: Citations must reference other provisions
    sh:property [
        sh:path :cites ;
        sh:class :LegalProvision ;
        sh:message "Citations must reference other legal provisions"@en
    ] .

# ==============================================================================
# CONSTITUTIONAL ARTICLE SHAPE
# ==============================================================================

shapes:ConstitutionalArticleShape a sh:NodeShape ;
    sh:targetClass :ConstitutionalArticle ;
    sh:name "Constitutional Article Validation"@en ;
    
    # REQUIRED: Article number (1-120)
    sh:property [
        sh:path :articleNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:positiveInteger ;
        sh:minInclusive 1 ;
        sh:maxInclusive 120 ;
        sh:message "Constitutional articles must be numbered 1-120"@en
    ] ;
    
    # REQUIRED: Must be part of Constitution
    sh:property [
        sh:path eli:is_part_of ;
        sh:class :Constitution ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Constitutional article must be part of Constitution"@en
    ] ;
    
    # REQUIRED: Must belong to Constitutional Law domain
    sh:property [
        sh:path :belongsToDomain ;
        sh:hasValue :ConstitutionalLaw ;
        sh:message "Constitutional articles must belong to Constitutional Law domain"@en
    ] .

# ==============================================================================
# ARTICLE/PARAGRAPH/SECTION SHAPES
# ==============================================================================

shapes:ArticleShape a sh:NodeShape ;
    sh:targetClass :Article ;
    sh:name "Article Validation"@en ;
    
    # REQUIRED: Article number
    sh:property [
        sh:path :articleNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:positiveInteger ;
        sh:message "Every article must have exactly one article number"@en
    ] ;
    
    # UNIQUE: No two articles in same act can have same number
    sh:sparql [
        sh:message "Article numbers must be unique within each legislative act"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            PREFIX eli: <http://data.europa.eu/eli/ontology#>
            SELECT $this ?other ?act ?number
            WHERE {
                $this a :Article .
                $this :articleNumber ?number .
                $this eli:is_part_of ?act .
                ?other a :Article .
                ?other :articleNumber ?number .
                ?other eli:is_part_of ?act .
                FILTER ($this != ?other)
            }
        """ ;
    ] .

shapes:ParagraphShape a sh:NodeShape ;
    sh:targetClass :Paragraph ;
    sh:name "Paragraph Validation"@en ;
    
    # REQUIRED: Must be part of an article
    sh:property [
        sh:path eli:is_part_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :Article ;
        sh:message "Every paragraph must be part of exactly one article"@en
    ] ;
    
    # REQUIRED: Paragraph number
    sh:property [
        sh:path :paragraphNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:positiveInteger ;
        sh:message "Every paragraph must have exactly one paragraph number"@en
    ] .

shapes:SectionShape a sh:NodeShape ;
    sh:targetClass :Section ;
    sh:name "Section Validation"@en ;
    
    # REQUIRED: Must be part of a paragraph
    sh:property [
        sh:path eli:is_part_of ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :Paragraph ;
        sh:message "Every section must be part of exactly one paragraph"@en
    ] .

# ==============================================================================
# JUDICIAL DECISION SHAPES
# ==============================================================================

shapes:JudicialDecisionShape a sh:NodeShape ;
    sh:targetClass :JudicialDecision ;
    sh:name "Judicial Decision Validation"@en ;
    
    # REQUIRED: Case number
    sh:property [
        sh:path :caseNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every judicial decision must have a case number"@en
    ] ;
    
    # REQUIRED: Issued by judicial authority
    sh:property [
        sh:path :issuedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :JudicialAuthority ;
        sh:message "Every judicial decision must be issued by a judicial authority"@en
    ] ;
    
    # REQUIRED: Decision date
    sh:property [
        sh:path dct:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Every judicial decision must have a decision date"@en
    ] ;
    
    # OPTIONAL: Interprets provisions
    sh:property [
        sh:path :interpretsProvision ;
        sh:class :LegalProvision ;
        sh:message "If present, must interpret actual legal provisions"@en
    ] .

# ==============================================================================
# AMENDMENT RELATIONSHIP SHAPES
# ==============================================================================

shapes:AmendmentShape a sh:NodeShape ;
    sh:targetSubjectsOf :amends ;
    sh:name "Amendment Relationship Validation"@en ;
    
    # CONSTRAINT: Subject and object must both be legislative acts
    sh:property [
        sh:path :amends ;
        sh:class :LegislativeAct ;
        sh:message "Amendment subject and object must both be legislative acts"@en
    ] ;
    
    # CONSTRAINT: Cannot amend self
    sh:sparql [
        sh:message "A legislative act cannot amend itself"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this ?target
            WHERE {
                $this :amends ?target .
                FILTER ($this = ?target)
            }
        """ ;
    ] ;
    
    # CONSTRAINT: Amending act must be newer than amended act
    sh:sparql [
        sh:message "Amending act must have a later date than the amended act"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            PREFIX eli: <http://data.europa.eu/eli/ontology#>
            SELECT $this ?target ?thisDate ?targetDate
            WHERE {
                $this :amends ?target .
                $this eli:date_document ?thisDate .
                ?target eli:date_document ?targetDate .
                FILTER (?thisDate <= ?targetDate)
            }
        """ ;
    ] .

# ==============================================================================
# REPEAL RELATIONSHIP SHAPES
# ==============================================================================

shapes:RepealShape a sh:NodeShape ;
    sh:targetSubjectsOf :repeals ;
    sh:name "Repeal Relationship Validation"@en ;
    
    # CONSTRAINT: Cannot repeal self
    sh:sparql [
        sh:message "A legislative act cannot repeal itself"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this ?target
            WHERE {
                $this :repeals ?target .
                FILTER ($this = ?target)
            }
        """ ;
    ] ;
    
    # CONSTRAINT: Repealing act must be newer
    sh:sparql [
        sh:message "Repealing act must have a later date than the repealed act"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            PREFIX eli: <http://data.europa.eu/eli/ontology#>
            SELECT $this ?target ?thisDate ?targetDate
            WHERE {
                $this :repeals ?target .
                $this eli:date_document ?thisDate .
                ?target eli:date_document ?targetDate .
                FILTER (?thisDate <= ?targetDate)
            }
        """ ;
    ] .

# ==============================================================================
# CITATION RELATIONSHIP SHAPES
# ==============================================================================

shapes:CitationShape a sh:NodeShape ;
    sh:targetSubjectsOf :cites ;
    sh:name "Citation Relationship Validation"@en ;
    
    # CONSTRAINT: Both subject and object must be provisions
    sh:property [
        sh:path :cites ;
        sh:class :LegalProvision ;
        sh:message "Both citing and cited must be legal provisions"@en
    ] ;
    
    # CONSTRAINT: Cannot cite self
    sh:sparql [
        sh:message "A provision cannot cite itself"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this ?target
            WHERE {
                $this :cites ?target .
                FILTER ($this = ?target)
            }
        """ ;
    ] .

# ==============================================================================
# LEGAL DOMAIN SHAPES
# ==============================================================================

shapes:LegalDomainShape a sh:NodeShape ;
    sh:targetClass :LegalDomain ;
    sh:name "Legal Domain Validation"@en ;
    
    # REQUIRED: Domain label
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every legal domain must have a label"@en
    ] .

# ==============================================================================
# ELI COMPLIANCE SHAPES
# ==============================================================================

shapes:ELIComplianceShape a sh:NodeShape ;
    sh:targetClass eli:LegalExpression ;
    sh:name "ELI Standard Compliance"@en ;
    sh:description "Validates compliance with ELI 1.3 specification"@en ;
    
    # REQUIRED: ELI identifier
    sh:property [
        sh:path eli:id_local ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every ELI resource must have a local identifier"@en
    ] ;
    
    # REQUIRED: Language
    sh:property [
        sh:path dct:language ;
        sh:minCount 1 ;
        sh:message "Every ELI resource must declare its language"@en
    ] ;
    
    # REQUIRED: Type
    sh:property [
        sh:path dct:type ;
        sh:minCount 1 ;
        sh:message "Every ELI resource must have a type"@en
    ] .

# ==============================================================================
# DATA QUALITY SHAPES
# ==============================================================================

shapes:DataQualityShape a sh:NodeShape ;
    sh:targetClass :LegalProvision ;
    sh:name "Data Quality Validation"@en ;
    
    # WARNING: Missing legal effect description
    sh:property [
        sh:path :hasLegalEffect ;
        sh:severity sh:Warning ;
        sh:minCount 1 ;
        sh:message "Provision should have a legal effect description (best practice)"@en
    ] ;
    
    # WARNING: Missing domain classification
    sh:property [
        sh:path :belongsToDomain ;
        sh:severity sh:Warning ;
        sh:minCount 1 ;
        sh:message "Provision should be classified into at least one legal domain (best practice)"@en
    ] .

# ==============================================================================
# INTEGRITY CONSTRAINTS
# ==============================================================================

shapes:NoCircularReferencesShape a sh:NodeShape ;
    sh:targetClass :LegislativeAct ;
    sh:name "No Circular References"@en ;
    
    # CONSTRAINT: No circular amendment chains
    sh:sparql [
        sh:message "Circular amendment chains are not allowed"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this
            WHERE {
                $this :amends+ $this .
            }
        """ ;
    ] ;
    
    # CONSTRAINT: No circular repeal chains
    sh:sparql [
        sh:message "Circular repeal chains are not allowed"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this
            WHERE {
                $this :repeals+ $this .
            }
        """ ;
    ] .

# ==============================================================================
# CROSS-REFERENCE VALIDATION
# ==============================================================================

shapes:CrossReferenceIntegrityShape a sh:NodeShape ;
    sh:targetClass :LegalProvision ;
    sh:name "Cross-Reference Integrity"@en ;
    
    # CONSTRAINT: All cited provisions must exist
    sh:sparql [
        sh:message "All cited provisions must exist in the dataset"@en ;
        sh:select """
            PREFIX : <https://stavropouloslaw.com/ontology/legal#>
            SELECT $this ?cited
            WHERE {
                $this :cites ?cited .
                FILTER NOT EXISTS { ?cited a :LegalProvision }
            }
        """ ;
    ] .

# ==============================================================================
# METADATA COMPLETENESS SHAPES
# ==============================================================================

shapes:MetadataCompletenessShape a sh:NodeShape ;
    sh:targetClass :LegislativeAct ;
    sh:name "Metadata Completeness Check"@en ;
    sh:severity sh:Warning ;
    
    # BEST PRACTICE: Creator/publisher info
    sh:property [
        sh:path dct:creator ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Best practice: Legislative acts should have creator metadata"@en
    ] ;
    
    # BEST PRACTICE: Description
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Best practice: Legislative acts should have descriptions"@en
    ] .

# ==============================================================================
# VALIDATION REPORT CONFIGURATION
# ==============================================================================

shapes:ValidationConfiguration a sh:ValidationReport ;
    rdfs:label "Greek Legal Data Validation Configuration"@en ;
    rdfs:comment """
    This SHACL shapes file provides comprehensive validation for Greek legal data.
    
    SEVERITY LEVELS:
    - sh:Violation: Critical errors that must be fixed
    - sh:Warning: Issues that should be addressed
    - sh:Info: Best practice recommendations
    
    VALIDATION COVERAGE:
    - Structural integrity (articles, paragraphs, sections)
    - Relationship consistency (amendments, repeals, citations)
    - ELI standard compliance
    - Data quality and completeness
    - No circular references
    - Cross-reference integrity
    
    USAGE:
    Use with pyshacl, Apache Jena SHACL, or TopBraid SHACL validator:
    
    pyshacl -s shapes/legal-shapes.ttl -d deployment/data.ttl -f human
    
    EXPECTED RESULTS:
    - 2,500+ validation checks
    - 99.7%+ compliance rate
    - All Violations must be addressed before production
    """@en .

# ==============================================================================
# END OF SHACL SHAPES
# ==============================================================================
