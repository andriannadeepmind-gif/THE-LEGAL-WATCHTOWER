# AUTHORITY ASSERTION
# ==============================================================================

<#authority-assertion> a law:AuthorityAssertion ;
    rdfs:label "Comprehensive Authority Assertion for Greek Constitution Semantic Corpus"@en ;
    law:assertionDate "2025-11-13T18:30:00"^^xsd:dateTime ;
    law:assertedBy <#spyridon-stavropoulos> ;
    law:assertedFor <https://stavropouloslaw.com/eli/gr/const> ;
    
    law:assertion """
        This Authority Assertion formally declares that:
        
        1. The Greek Constitution Semantic Corpus is the original work of 
           Spyridon Stavropoulos and STAVROPOULOS LAW.
        
        2. All semantic mappings, RDF representations, and technical implementations
           are created under professional legal expertise and responsibility.
        
        3. The corpus is protected by copyright and sui generis database rights.
        
        4. This assertion is digitally signed with a Qualified Electronic Signature
           having the legal equivalence of a handwritten signature.
        
        5. The integrity is guaranteed through blockchain anchoring and IPFS storage.
        
        6. All legal responsibilities and liabilities are accepted as stated.
        
        This assertion is legally binding and enforceable.
    """@en ;
    
