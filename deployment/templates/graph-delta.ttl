[] a delta:Modification ;
    delta:subject <https://stavropouloslaw.com/eli/gr/const/article-086> ;
    delta:predicate eli:prescription_period ;
    delta:oldValue "5 years"@en ;
    delta:newValue "10 years"@en ;
    delta:changeReason "Extended prescription period for ministerial crimes"@en ;
    delta:semanticImpact "high" ;
    delta:legalImplications "Significant extension of accountability period"@en ;
    delta:hash "d1a9f7c3e8b2d6c4b1a7f5e3d1c9b7e5d3c1b9e7" .

[] a delta:Modification ;
    delta:subject <https://stavropouloslaw.com/eli/gr/const/article-086> ;
    delta:predicate eli:description ;
    delta:paragraph 4 ;
    delta:oldValue """Η παραγραφή των πράξεων που προβλέπει ο νόμος κατά την παράγραφο 1 αναστέλλεται κατά τη διάρκεια της βουλευτικής περιόδου."""@el ;
    delta:newValue """Η παραγραφή των εγκλημάτων που τελούνται από Υπουργούς δεν αρχίζει όσο αυτοί ασκούν τα καθήκοντά τους. Η αναστολή της παραγραφής δεν μπορεί να υπερβεί τα τρία έτη."""@el ;
    delta:changeReason "Modified prescription suspension rules"@en ;
    delta:hash "e2b1a8f6c4d9e7b3d5c2a1f9e8d7c6b5a4f3e2d1" .

