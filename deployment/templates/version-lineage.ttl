# VERSION 1.1.0 (1986 Amendment)
<https://stavropouloslaw.com/eli/gr/const/version/1.1.0> a prov:Entity, eli:LegalResource ;
    eli:version "1.1.0" ;
    eli:version_date "1986-03-07"^^xsd:date ;
    dct:title "Constitution of Greece - 1986 Amendment"@en ;
    dct:title "Σύνταγμα της Ελλάδας - Αναθεώρηση 1986"@el ;
    dct:created "1986-03-07T00:00:00"^^xsd:dateTime ;
    dct:valid "1986-03-07/2001-04-16"^^xsd:date ;
    
    # Version linkage
    prov:wasRevisionOf <https://stavropouloslaw.com/eli/gr/const/version/1.0.0> ;
    dct:replaces <https://stavropouloslaw.com/eli/gr/const/version/1.0.0> ;
    eli:amended_by <https://parliament.gr/resolution/1986-03-07> ;
    
    # Attribution and activity
    prov:wasAttributedTo <https://parliament.gr/#institution> ;
    prov:wasGeneratedBy <https://stavropouloslaw.com/eli/gr/const/activity/amendment-1986> ;
    
    # Changes description
    dct:description """Major amendments affecting Presidential powers:
    - Article 35: Presidential term
    - Article 37: Presidential election procedure
    - Article 38: Acting President provisions
    - Article 43: Presidential decree authority
    - Article 44: Emergency powers"""@en ;
    
    # Semantic anchors for changes
    delta:hasAnchor [
        a delta:SemanticAnchor ;
        delta:anchorType "constitutional_amendment" ;
        delta:targetArticle 35, 37, 38, 43, 44 ;
        delta:changeType "modification" ;
        delta:legalBasis "Parliamentary Resolution 07/03/1986" ;
        delta:hash "a7f8d9e5b3c1..."
    ] .

# VERSION 2.0.0 (2001 Amendment)
