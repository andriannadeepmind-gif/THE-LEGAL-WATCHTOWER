# VERSION 2.2.0 (2019 Amendment)
<https://stavropouloslaw.com/eli/gr/const/version/2.2.0> a prov:Entity, eli:LegalResource ;
    eli:version "2.2.0" ;
    eli:version_date "2019-11-25"^^xsd:date ;
    dct:title "Constitution of Greece - 2019 Amendment"@en ;
    dct:title "Σύνταγμα της Ελλάδας - Αναθεώρηση 2019"@el ;
    dct:created "2019-11-25T00:00:00"^^xsd:dateTime ;
    dct:valid "2019-11-25/"^^xsd:date ;  # Currently valid
    
    # Complete version chain
    prov:wasRevisionOf <https://stavropouloslaw.com/eli/gr/const/version/2.1.0> ;
    prov:wasDerivedFrom 
        <https://stavropouloslaw.com/eli/gr/const/version/1.0.0>,
        <https://stavropouloslaw.com/eli/gr/const/version/1.1.0>,
        <https://stavropouloslaw.com/eli/gr/const/version/2.0.0> ;
    dct:replaces <https://stavropouloslaw.com/eli/gr/const/version/2.1.0> ;
    owl:priorVersion <https://stavropouloslaw.com/eli/gr/const/version/2.1.0> ;
    owl:versionInfo "2.2.0 - Current Version" ;
    
    # Current version marker
    eli:is_current_version true ;
    dct:isVersionOf <https://stavropouloslaw.com/eli/gr/const> ;
    
    # Changes
    dct:description """Latest constitutional revision including:
    - Article 3: Church-State relations clarification
    - Article 16: Non-state universities permitted
    - Article 32: Electoral law amendments
    - Article 54: Electoral system
    - Article 86: Ministerial responsibility
    - Article 101A: Independent authorities"""@en ;
    
    # Blockchain proof
    delta:blockchainProof [
        a delta:BlockchainAnchor ;
        delta:ethereum "0x7f3d9e5b3c1a8f2d6e9c4b7a5e8d3f2a1c9b8e7d" ;
        delta:arweave "ar://9e8d7c6b5a4f3e2d1c9b8a7f6e5d4c3b2a1" ;
        delta:ipfs "Qm7a8f9e5d3c1b9a7f6e5d4c3b2a1e9d8c7b6a5f4e3d2"
    ] .

