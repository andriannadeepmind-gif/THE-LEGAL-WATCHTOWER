    prov:wasAttributedTo <https://parliament.gr/#institution> ;
    prov:wasGeneratedBy <https://stavropouloslaw.com/eli/gr/const/activity/amendment-2001> ;
    
    # Major changes
    dct:description """Comprehensive revision including:
    - New fundamental rights provisions
    - Environmental protection (Article 24)
    - Data protection (Article 9A)
    - Transparency requirements
    - 31 articles amended in total"""@en ;
    
    # Multiple semantic anchors
    delta:hasAnchor [
        a delta:SemanticAnchor ;
        delta:anchorType "constitutional_amendment" ;
        delta:targetArticle 9 ;
        delta:changeType "addition" ;
        delta:legalBasis "Addition of Article 9A - Data Protection" ;
        delta:hash "b8e7c4a2d5f9..."
    ], [
        a delta:SemanticAnchor ;
        delta:anchorType "constitutional_amendment" ;
        delta:targetArticle 24 ;
        delta:changeType "modification" ;
        delta:legalBasis "Enhanced environmental protection" ;
        delta:hash "c9f8d5b3e7a1..."
    ] .

