(:knowledge-pack :procedure 1
 ;; Δικονομικοί τελεστές — α΄ κύμα (ΚΠολΔ ένδικα μέσα, με τις πραγματικές
 ;; προθεσμίες): (:operator ID ΠΗΓΗ ΠΡΟΫΠΟΘΕΣΕΙΣ ΑΠΟΤΕΛΕΣΜΑΤΑ [ΗΜΕΡΕΣ ΑΦΕΤΗΡΙΑ])
 ;; Η αφετηρία είναι γεγονός (:γεγονός <κατηγόρημα> "ΗΗΗΗ-ΜΜ-ΗΗ").

 ;; ΕΦΕΣΗ — ΚΠολΔ 518 §1: 30 ημέρες από την επίδοση της απόφασης.
 (:operator :άσκηση-έφεσης "kpolitikis:518"
  ((:γεγονός :απόφαση :οριστική))
  ((:γεγονός :έφεση :ασκήθηκε))
  30 :επιδόθηκε)

 ;; ΑΝΑΚΟΠΗ ΕΡΗΜΟΔΙΚΙΑΣ — ΚΠολΔ 503 §1: 15 ημέρες από την επίδοση.
 (:operator :ανακοπή-ερημοδικίας "kpolitikis:503"
  ((:γεγονός :απόφαση :ερήμην))
  ((:γεγονός :ανακοπή :ασκήθηκε))
  15 :επιδόθηκε)

 ;; ΑΝΑΙΡΕΣΗ — ΚΠολΔ 564 §1: 30 ημέρες από την επίδοση (τελεσίδικης).
 (:operator :άσκηση-αναίρεσης "kpolitikis:564"
  ((:γεγονός :απόφαση :τελεσίδικη))
  ((:γεγονός :αναίρεση :ασκήθηκε))
  30 :επιδόθηκε))
