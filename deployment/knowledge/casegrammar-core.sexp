(:knowledge-pack :verb-frames 1
 ;; ── Σ4β: πλαίσια πτώσεων (Fillmore) — η γέφυρα αφήγησης → γεγονότων ──
 ;; Κάθε ρήμα-λήμμα χαρτογραφείται στο κατηγόρημα της γλώσσας γεγονότων
 ;; που μιλούν οι ειδικές υποστάσεις (tatbestand-core.sexp).

 ;; ρήματα → κατηγορήματα
 (:frame "αφαιρώ"       :αφαιρεί)      ; ΠΚ 372
 (:frame "θανατώνω"     :θανατώνει)    ; ΠΚ 299
 (:frame "σκοτώνω"      :θανατώνει)    ; συνώνυμο της καθομιλουμένης
 (:frame "ζημιώνω"      :ζημιώνει)     ; ΑΚ 914
 (:frame "ιδιοποιούμαι" :ιδιοποιείται) ; ΠΚ 375

 ;; ουσιαστικά → Κατηγορίες (τροφοδοτούν τον Barbara: πορτοφόλι ⊂ κινητό …)
 (:noun-class "πορτοφόλι"  :κινητό)
 (:noun-class "ρολόι"      :κινητό)
 (:noun-class "κόσμημα"    :κινητό)
 (:noun-class "εργαλείο"   :κινητό)
 (:noun-class "αυτοκίνητο" :όχημα)
 (:noun-class "οικόπεδο"   :ακίνητο)

 ;; δείκτες: γεννούν γεγονός για τον ΔΡΑΣΤΗ όπου κι αν εμφανίζονται
 (:marker "ιδιοποιούμαι" :σκοπός     :παράνομη-ιδιοποίηση) ; «για να το ιδιοποιηθεί»
 (:marker "δόλος"        :ενεργεί-με :δόλο)                ; «με δόλο / εκ δόλου»

 ;; επίθετα → κατηγορήματα αντικειμένου («ξένο κινητό πράγμα» = ∧ κατηγορίες)
 (:adjective "ξένος"     :ξένο)
 (:adjective "κινητός"   :κινητό)
 (:adjective "ακίνητος"  :ακίνητο)
 (:adjective "παράνομος" :παράνομο)

 ;; ── ΟΝΕΙΡΑ ΔΙΚΑΣΜΕΝΑ (05-07-2026): 21 πλαίσια ρημάτων του ΠΚ, προταθέντα
 ;;    από τον σύμβουλο-LLM (Claude, κατ' εντολή δημιουργού), ΟΛΑ περασμένα
 ;;    από validate-dream (μαρτυρία τύπου στα κείμενα) — 21/21 δεκτά ──
 (:frame "προξενώ" :προξενεί)
 (:frame "προκαλώ" :προκαλεί)
 (:frame "ενεργώ" :ενεργεί)
 (:frame "παρεμποδίζω" :παρεμποδίζει)
 (:frame "τελώ" :τελεί)
 (:frame "επιχειρώ" :επιχειρεί)
 (:frame "ασκώ" :ασκεί)
 (:frame "καταστρέφω" :καταστρέφει)
 (:frame "παραλείπω" :παραλείπει)
 (:frame "ζητώ" :ζητεί)
 (:frame "καταρτίζω" :καταρτίζει)
 (:frame "παραποιώ" :παραποιεί)
 (:frame "εισέρχομαι" :εισέρχεται)
 (:frame "βιαιοπραγώ" :βιαιοπραγεί)
 (:frame "νοθεύω" :νοθεύει)
 (:frame "χρησιμοποιώ" :χρησιμοποιεί)
 (:frame "υιοθετώ" :υιοθετεί)
 (:frame "εξωθώ" :εξωθεί)
 (:frame "υποκινώ" :υποκινεί)
 (:frame "προμηθεύομαι" :προμηθεύεται)
 (:frame "παρέχω" :παρέχει)
 ;; β΄ γύρος ονείρων (05-07-2026), ομοίως δικασμένα:
 (:frame "εμποδίζω" :εμποδίζει)
 (:frame "αποκρύπτω" :αποκρύπτει)
 (:frame "βλάπτω" :βλάπτει)
 (:frame "εγκαταλείπω" :εγκαταλείπει)
 (:frame "εκθέτω" :εκθέτει)
 (:frame "διαταράσσω" :διαταράσσει)
 (:frame "ματαιώνω" :ματαιώνει)
 (:frame "παραβιάζω" :παραβιάζει)
 (:frame "συμμετέχω" :συμμετέχει)
 (:frame "συγκροτώ" :συγκροτεί)
 (:frame "ανακοινώνω" :ανακοινώνει)
 (:frame "παραδίδω" :παραδίδει)
 (:frame "καταπείθω" :καταπείθει)
 (:frame "αποφασίζω" :αποφασίζει))


