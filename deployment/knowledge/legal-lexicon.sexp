(:knowledge-pack :lexicon 1
 ;; ── Ουσιαστικά που ΚΛΙΝΟΝΤΑΙ (γένεση + κατανόηση, μία δήλωση) ──
 ;; παροξύτονα/προπαροξύτονα που χωρούν ακριβώς στα κλιτικά πρότυπα·
 ;; το ΘΕΜΑ2 (κατεβασμένος τόνος) δηλώνεται όπου η παραδοσιακή γραμματική το απαιτεί
 (:noun "δικαστήριο"    :n :n-o  "δικαστήρι"   "δικαστηρί")   ; του δικαστηρίου, των δικαστηρίων
 (:noun "συμβόλαιο"     :n :n-o  "συμβόλαι"    "συμβολαί")    ; του συμβολαίου
 (:noun "έγγραφο"       :n :n-o  "έγγραφ"      "εγγράφ")      ; του εγγράφου, των εγγράφων
 (:noun "κληρονόμος"    :m :m-os "κληρονόμ")                  ; του κληρονόμου
 (:noun "κατηγορούμενος" :m :m-os "κατηγορούμεν" "κατηγορουμέν") ; του κατηγορουμένου
 (:noun "μάρτυρας"      :m :m-as "μάρτυρ"      "μαρτύρ")      ; των μαρτύρων
 (:noun "δανειστής"     :m :m-is "δανειστ")                   ; του δανειστή, των δανειστών
 (:noun "εγγυητής"      :m :m-is "εγγυητ")                    ; του εγγυητή
 (:noun "έφεση"         :f :f-si "έφεσ"        "εφέσ")        ; οι εφέσεις, των εφέσεων
 (:noun "αίτηση"        :f :f-si "αίτησ"       "αιτήσ")       ; των αιτήσεων
 (:noun "ένσταση"       :f :f-si "ένστασ"      "ενστάσ")      ; των ενστάσεων
 (:noun "εκτέλεση"      :f :f-si "εκτέλεσ"     "εκτελέσ")     ; της εκτέλεσης, των εκτελέσεων
 (:noun "υποχρέωση"     :f :f-si "υποχρέωσ"    "υποχρεώσ")    ; των υποχρεώσεων
 (:noun "κατάθεση"      :f :f-si "κατάθεσ"     "καταθέσ")     ; των καταθέσεων

 ;; ── Λέξεις με ΡΗΤΕΣ μορφές (μόνο κατανόηση) — οξύτονα θηλυκά, -μα ουδέτερα,
 ;;    ρήματα: δεν χωρούν στα πρότυπα, δηλώνονται πλήρεις, ποτέ μισοσωστές ──
 (:lemma "εισαγγελέας" ("εισαγγελέα" "εισαγγελείς" "εισαγγελέων"))  ; -έας: δική του κλίση
 (:lemma "περιστατικό" ("περιστατικού" "περιστατικά" "περιστατικών"))
 (:lemma "πραγματικός" ("πραγματικού" "πραγματικό" "πραγματική" "πραγματικής" "πραγματικά" "πραγματικές" "πραγματικών"))
 (:lemma "αγωγή"      ("αγωγής" "αγωγές" "αγωγών"))
 (:lemma "ποινή"      ("ποινής" "ποινές" "ποινών"))
 (:lemma "προσφυγή"   ("προσφυγής" "προσφυγές" "προσφυγών"))
 (:lemma "δίκη"       ("δίκης" "δίκες" "δικών"))
 (:lemma "φυλάκιση"   ("φυλάκισης" "φυλακίσεως" "φυλακίσεις" "φυλακίσεων"))
 (:lemma "κάθειρξη"   ("κάθειρξης" "καθείρξεως" "καθείρξεις" "καθείρξεων"))
 (:lemma "αδίκημα"    ("αδικήματος" "αδικήματα" "αδικημάτων"))
 (:lemma "έγκλημα"    ("εγκλήματος" "εγκλήματα" "εγκλημάτων"))
 (:lemma "δικαίωμα"   ("δικαιώματος" "δικαιώματα" "δικαιωμάτων"))
 (:lemma "δεδικασμένο" ("δεδικασμένου" "δεδικασμένα" "δεδικασμένων"))
 (:lemma "παραγραφή"  ("παραγραφής" "παραγραφές" "παραγραφών"))
 (:lemma "αναίρεση"   ("αναίρεσης" "αναιρέσεως" "αναιρέσεις" "αναιρέσεων"))
 (:lemma "ασκώ"       ("ασκεί" "ασκούν" "ασκείται" "ασκούνται" "άσκησε" "ασκήθηκε" "ασκηθεί" "άσκηση"))
 (:lemma "καταθέτω"   ("καταθέτει" "καταθέτουν" "κατέθεσε" "κατατεθεί" "κατατίθεται"))
 (:lemma "εκδίδω"     ("εκδίδει" "εκδίδεται" "εξέδωσε" "εκδοθεί" "εκδόθηκε" "έκδοση"))
 (:lemma "προσβάλλω"  ("προσβάλλει" "προσβάλλεται" "προσέβαλε" "προσβληθεί" "προσβολή"))

 ;; ── Σ4β: ρήματα-πλαίσια της γραμματικής πτώσεων + ουσιαστικά αφηγήσεων ──
 (:lemma "αφαιρώ"       ("αφαιρεί" "αφαιρούν" "αφαίρεσε" "αφαίρεσαν" "αφαιρέσει" "αφαίρεση"))
 (:lemma "θανατώνω"     ("θανατώνει" "θανάτωσε" "θανάτωσαν" "θανατώσει" "θανάτωση"))
 (:lemma "σκοτώνω"      ("σκοτώνει" "σκότωσε" "σκότωσαν" "σκοτώσει"))
 (:lemma "ζημιώνω"      ("ζημιώνει" "ζημίωσε" "ζημίωσαν" "ζημιώσει" "ζημία"))
 (:lemma "ιδιοποιούμαι" ("ιδιοποιείται" "ιδιοποιήθηκε" "ιδιοποιήθηκαν" "ιδιοποιηθεί"))
 (:lemma "πορτοφόλι"    ("πορτοφολιού" "πορτοφόλια" "πορτοφολιών"))
 (:lemma "ρολόι"        ("ρολογιού" "ρολόγια" "ρολογιών"))
 (:lemma "δόλος"        ("δόλου" "δόλο"))

 ;; ── Αλυσίδα συλλογισμού στον διάλογο: σκανδάλες + πράξεις-εγκλήματα ──
 (:lemma "στοιχειοθετώ" ("στοιχειοθετείται" "στοιχειοθετηθεί" "στοιχειοθετούνται" "στοιχειοθέτηση"))
 (:lemma "προϋπόθεση"   ("προϋπόθεσης" "προϋποθέσεις" "προϋποθέσεων"))
 (:lemma "χρειάζομαι"   ("χρειάζεται" "χρειαστεί" "χρειάζονται"))
 (:lemma "αποδεικνύω"   ("αποδεικνύεται" "αποδείξω" "αποδειχθεί" "αποδεικνύονται"))
 (:lemma "κλοπή"        ("κλοπής" "κλοπές" "κλοπών"))
 (:lemma "υπεξαίρεση"   ("υπεξαίρεσης" "υπεξαιρέσεως" "υπεξαιρέσεις" "υπεξαιρέσεων"))
 (:lemma "ανθρωποκτονία" ("ανθρωποκτονίας" "ανθρωποκτονίες" "ανθρωποκτονιών"))
 (:lemma "αδικοπραξία"  ("αδικοπραξίας" "αδικοπραξίες" "αδικοπραξιών"))
 (:lemma "τηρώ"         ("τηρεί" "τηρούν" "τηρείται" "τηρούνται" "τήρηση"))
 (:lemma "έμπορος"      ("έμποροι" "εμπόρου" "εμπόρων" "έμπορο"))
 ;; ── Σ12α: η σύνταξη του νομοθέτη — επίθετα, κεφαλές, κυρώσεις ──
 (:lemma "ξένος"        ("ξένο" "ξένου" "ξένη" "ξένης" "ξένα" "ξένων"))
 (:lemma "κινητός"      ("κινητό" "κινητού" "κινητή" "κινητά" "κινητών"))
 (:lemma "ακίνητος"     ("ακίνητο" "ακινήτου" "ακίνητα" "ακινήτων"))
 (:lemma "παράνομος"    ("παράνομο" "παράνομα" "παράνομη" "παρανόμου" "παρανόμως"))
 (:lemma "πράγμα"       ("πράγματος" "πράγματα" "πραγμάτων"))
 (:lemma "τιμωρώ"       ("τιμωρείται" "τιμωρούνται" "τιμωρηθεί"))
 (:lemma "κατοχή"       ("κατοχής" "κατοχή"))

 ;; ── ΟΝΕΙΡΑ ΔΙΚΑΣΜΕΝΑ (05-07-2026): μορφές των 20 νέων ρημάτων ──
