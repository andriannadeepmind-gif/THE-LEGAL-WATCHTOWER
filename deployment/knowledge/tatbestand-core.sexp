(:knowledge-pack :tatbestand 1
 ;; Α΄ κύμα ειδικών υποστάσεων — κάθε κανόνας με ΠΗΓΗ, προϋποθέσεις με
 ;; μεταβλητές (:?χ), και ΛΟΓΟΥΣ ΑΡΣΗΣ όπου προβλέπονται. Γλώσσα γεγονότων:
 ;; (:γεγονός <υποκείμενο> <κατηγόρημα> <αντικείμενο/τιμή>)

 ;; ΚΛΟΠΗ — ΠΚ 372: αφαίρεση ξένου κινητού πράγματος με σκοπό παράνομης ιδιοποίησης.
 ;; Λόγος άρσης: συναίνεση του κατόχου (αναιρεί το άδικο της αφαίρεσης).
 (:norm :norm-klopi-372 :prohibition "poinikos:372" :penal
  ((:γεγονός :?δράστης :αφαιρεί :?πράγμα)
   (:γεγονός :?πράγμα :είναι :κινητό)
   (:γεγονός :?πράγμα :είναι :ξένο)
   (:γεγονός :?δράστης :σκοπός :παράνομη-ιδιοποίηση))
  (:πράξη :?δράστης :κλοπή :?πράγμα)
  ((:γεγονός :?δράστης :έχει-συναίνεση-κατόχου :?πράγμα)))

 ;; ΑΝΘΡΩΠΟΚΤΟΝΙΑ ΜΕ ΔΟΛΟ — ΠΚ 299.
 ;; Λόγος άρσης: νόμιμη άμυνα (ΠΚ 22 — αίρει το άδικο).
 (:norm :norm-anthropoktonia-299 :prohibition "poinikos:299" :penal
  ((:γεγονός :?δράστης :θανατώνει :?θύμα)
   (:γεγονός :?δράστης :ενεργεί-με :δόλο))
  (:πράξη :?δράστης :ανθρωποκτονία :?θύμα)
  ((:γεγονός :?δράστης :τελεί-σε :νόμιμη-άμυνα)))

 ;; ΑΔΙΚΟΠΡΑΞΙΑ — ΑΚ 914: όποιος ζημιώσει άλλον παράνομα και υπαίτια έχει
 ;; υποχρέωση αποζημίωσης.
 (:norm :norm-adikopraxia-914 :obligation "astikos:914" :civil
  ((:γεγονός :?δράστης :ζημιώνει :?ζημιωθείς)
   (:γεγονός :?δράστης :ενεργεί :παράνομα)
   (:γεγονός :?δράστης :ενεργεί :υπαίτια))
  (:πράξη :?δράστης :οφείλει-αποζημίωση :?ζημιωθείς)
  ())

 ;; ΥΠΕΞΑΙΡΕΣΗ — ΠΚ 375: παράνομη ιδιοποίηση ξένου κινητού που βρίσκεται
 ;; ΗΔΗ στην κατοχή του δράστη (η διάκριση από την κλοπή: όχι αφαίρεση).
 (:norm :norm-ypexairesi-375 :prohibition "poinikos:375" :penal
  ((:γεγονός :?δράστης :ιδιοποιείται :?πράγμα)
   (:γεγονός :?πράγμα :είναι :κινητό)
   (:γεγονός :?πράγμα :είναι :ξένο)
   (:γεγονός :?πράγμα :στην-κατοχή-του :?δράστης))
  (:πράξη :?δράστης :υπεξαίρεση :?πράγμα)
  ((:γεγονός :?δράστης :έχει-συναίνεση-κατόχου :?πράγμα))))
