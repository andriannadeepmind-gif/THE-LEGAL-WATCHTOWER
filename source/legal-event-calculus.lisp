;;;; source/legal-event-calculus.lisp
;;;; ============================================================================
;;;; BRAIN L3β — EVENT CALCULUS: η αντίληψη ΙΣΤΟΡΙΑΣ πάνω στο WFS
;;;; ============================================================================
;;;;
;;;; Η νομική αφήγηση είναι ακολουθία ΓΕΓΟΝΟΤΩΝ που γεννούν και σβήνουν
;;;; ΕΝΝΟΜΕΣ ΚΑΤΑΣΤΑΣΕΙΣ (κατοχή, κυριότητα, υπερημερία, ισχύς σύμβασης).
;;;; Χωρίς αυτό, το σύστημα βλέπει στιγμιότυπα — όχι υπόθεση (θεμελιώδες
;;;; κενό #2 του ελέγχου νοημοσύνης 05-07-2026).
;;;;
;;;; Discrete Event Calculus (Kowalski/Sergot, μορφή Mueller) ως ΔΗΛΩΤΙΚΟΙ
;;;; κανόνες της ΙΔΙΑΣ μηχανής WFS/JTMS — καμία νέα μηχανή:
;;;;   • θεμελίωση: συμβάν πριν το σημείο κρίσης που γεννά το ρευστό
;;;;   • διακοπή:   μεταγενέστερο συμβάν που το σβήνει (clipping)
;;;;   • αδράνεια:  ισχύει ⇐ θεμελίωση ∧ ΟΧΙ διακοπή — η ΑΡΝΗΣΗ ΩΣ ΑΠΟΤΥΧΙΑ
;;;;     του WFS ΕΙΝΑΙ η λύση του frame problem εδώ (commonsense inertia)
;;;;   • ο υπαρξιακός χαρακτήρας της διακοπής ΡΗΤΟΣ (ενδιάμεσο παράγωγο) —
;;;;     το μοτίβο που καθιερώθηκε στη διόρθωση του precedent-needs-review.
;;;;
;;;; Η χρονική σύγκριση γίνεται από τους :where φραγμούς του ΜΕΤΑΚΥΚΛΙΚΟΥ
;;;; αποτιμητή: κάθε (:ισχύει …) φέρει στην απόδειξή του πιστοποιητικά
;;;; date</date<= ΑΝΕΞΑΡΤΗΤΑ ΕΠΑΛΗΘΕΥΜΕΝΑ (κριτήριο de Bruijn) — η ιστορία
;;;; δεν συμπεραίνεται απλώς: αποδεικνύεται μέχρι την τελευταία ημερομηνία.
;;;;
;;;; ΣΥΜΒΑΣΗ ΟΡΙΩΝ (δηλωμένη): συμβάν-γένεσης μετρά ΑΠΟ την ημέρα του
;;;; (date<= τ1 τ)· συμβάν-λήξης μετρά ΤΗΝ ημέρα του (date<= τ2 τ) και
;;;; απαιτεί να έπεται ΓΝΗΣΙΑ της γένεσης (date< τ1 τ2).
;;;;
;;;; Λεξιλόγιο γεγονότων (τα σεντ-εδάφη έρχονται από αφήγηση/αποφάσεις):
;;;;   (:συμβάν Ε ΕΙΔΟΣ "ΗΗΗΗ-ΜΜ-ΗΗ")   — το συμβάν Ε του ΕΙΔΟΥΣ στην ημερομηνία
;;;;   (:γεννά ΕΙΔΟΣ ΡΕΥΣΤΟ ΦΟΡΕΑΣ)     — γνώση πεδίου (πακέτα αργότερα)
;;;;   (:σβήνει ΕΙΔΟΣ ΡΕΥΣΤΟ ΦΟΡΕΑΣ)
;;;;   (:σημείο-κρίσης "ΗΗΗΗ-ΜΜ-ΗΗ")    — η στιγμή για την οποία ρωτάμε
;;;; Παράγωγα (πάντα με απόδειξη):
;;;;   (:θεμελίωση Ρ Φ Τ1 Τ) (:διακοπή Ρ Φ Τ1 Τ) (:ισχύει Ρ Φ Τ)

(defpackage :orchestrator.eventcalculus
  (:use :cl :orchestrator.inference))

(in-package :orchestrator.eventcalculus)

;; ① ΘΕΜΕΛΙΩΣΗ: συμβάν όχι μεταγενέστερο του σημείου κρίσης γεννά το ρευστό
(defrule ec-initiation
  :when  ((:συμβάν ?ε ?είδος ?τ1)
          (:γεννά ?είδος ?ρ ?φ)
          (:σημείο-κρίσης ?τ))
  :where ((date<= ?τ1 ?τ))
  :then  (:θεμελίωση ?ρ ?φ ?τ1 ?τ))

;; ② ΔΙΑΚΟΠΗ: γνήσια μεταγενέστερο συμβάν, όχι μετά την κρίση, σβήνει το
;;    ρευστό — ο υπαρξιακός χαρακτήρας («ΚΑΠΟΙΟ συμβάν») ρητός στο παράγωγο
(defrule ec-clipping
  :when  ((:θεμελίωση ?ρ ?φ ?τ1 ?τ)
          (:συμβάν ?ε2 ?είδος2 ?τ2)
          (:σβήνει ?είδος2 ?ρ ?φ))
  :where ((date< ?τ1 ?τ2) (date<= ?τ2 ?τ))
  :then  (:διακοπή ?ρ ?φ ?τ1 ?τ))

;; ③ ΑΔΡΑΝΕΙΑ (commonsense inertia): ό,τι θεμελιώθηκε και ΔΕΝ διακόπηκε,
;;    ισχύει στο σημείο κρίσης — negation-as-failure του WFS, όχι ευχή
(defrule ec-holds
  :when   ((:θεμελίωση ?ρ ?φ ?τ1 ?τ))
  :unless ((:διακοπή ?ρ ?φ ?τ1 ?τ))
  :then   (:ισχύει ?ρ ?φ ?τ))
