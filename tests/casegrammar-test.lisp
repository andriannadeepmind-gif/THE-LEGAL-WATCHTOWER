;;;; tests/casegrammar-test.lisp
;;;; ============================================================================
;;;; ΓΡΑΜΜΑΤΙΚΗ ΠΤΩΣΕΩΝ — regression lock της ανάθεσης ρόλων (θέμα=ΚΕΦΑΛΗ)
;;;; ============================================================================
;;;; Κλειδώνει το [0074] bug + τη μη-παλινδρόμηση:
;;;;   · «τα ξένα κινητά εργαλεία» ⇒ θέμα = ΕΡΓΑΛΕΙΑ (κεφαλή), ΟΧΙ «ξένα» (επίθετο)·
;;;;     τα επίθετα → κατηγορήματα κλάσης του θέματος (:είναι :ξένο ∧ :κινητό)·
;;;;   · OVS «Τον Γιώργο σκότωσε ο Νίκος» ⇒ δράστης=Νίκος, θέμα=Γιώργος (ΑΜΕΤΑΒΛΗΤΟ)·
;;;;   · κτήτορας μόνο από ΓΕΝΙΚΗ «το πορτοφόλι της Μαρίας» ⇒ θέμα=πορτοφόλι, :ξένο·
;;;;   · μεταγενέστερο ΠΛΑΓΙΟ αιτιατικό («την παράνομη ιδιοποίηση») ΔΕΝ κλέβει το θέμα.
;;;; ============================================================================

(in-package :orchestrator.casegrammar)

(defvar *pass* 0) (defvar *fail* 0)
(defmacro check (name form)
  `(handler-case
       (if ,form (progn (incf *pass*) (format t "  ok   ~A~%" ,name))
           (progn (incf *fail*) (format t "  FAIL ~A~%" ,name)))
     (error (e) (incf *fail*) (format t "  FAIL ~A (error: ~A)~%" ,name e))))

(orchestrator.knowledge-packs:ensure-fresh)

(defun facts (text) (values (parse-narrative text)))
(defun has (fs subj pred obj) (member (list :γεγονός subj pred obj) fs :test #'equal))
(defun pred-obj (fs pred) ; το αντικείμενο της ΠΡΩΤΗΣ πράξης με το δοθέν κατηγόρημα
  (let ((f (find-if (lambda (x) (and (eq (first x) :γεγονός) (eq (third x) pred))) fs)))
    (and f (fourth f))))
(defun nm (kw) (and (keywordp kw) (symbol-name kw)))

(format t "~%== θέμα = ΚΕΦΑΛΗ (όχι επίθετο) + επίθετα → κλάσεις ==~%")
(let* ((fs (facts "Ο δράστης αφαίρεσε τα ξένα κινητά εργαλεία."))
       (theme (pred-obj fs :αφαιρεί)))
  (check "υπάρχει πράξη :αφαιρεί" theme)
  (check "θέμα ΔΕΝ είναι επίθετο (:ξένο/:κινητό/:παράνομο)"
         (not (member theme '(:ξένο :κινητό :παράνομο :ξένος :κινητός))))
  (check "θέμα = κεφαλή «εργαλεία»" (and theme (search "ΕΡΓΑΛΕΙ" (nm theme))))
  (check "επίθετο «ξένα» → κλάση :ξένο του θέματος" (has fs theme :είναι :ξένο))
  (check "«κινητά»/noun-class → κλάση :κινητό του θέματος" (has fs theme :είναι :κινητό)))

(format t "~%== OVS: «Τον Γιώργο σκότωσε ο Νίκος» (ΑΜΕΤΑΒΛΗΤΟ) ==~%")
(let* ((fs (facts "Τον Γιώργο σκότωσε ο Νίκος."))
       (f (find-if (lambda (x) (eq (third x) :θανατώνει)) fs)))
  (check "υπάρχει πράξη :θανατώνει" f)
  (check "δράστης = Νίκος" (and f (search "ΝΙΚ" (nm (second f)))))
  (check "θύμα = Γιώργος" (and f (search "ΓΙΩΡΓ" (nm (fourth f))))))

(format t "~%== κτήτορας από ΓΕΝΙΚΗ: «το πορτοφόλι της Μαρίας» ==~%")
(let* ((fs (facts "Ο Ανδρέας αφαίρεσε το πορτοφόλι της Μαρίας για να το ιδιοποιηθεί."))
       (theme (pred-obj fs :αφαιρεί)))
  (check "θέμα = πορτοφόλι (όχι Μαρίας/κτήτορας)" (and theme (search "ΠΟΡΤΟΦ" (nm theme))))
  (check "κτήτορας ≠ δράστης ⇒ :ξένο" (has fs theme :είναι :ξένο))
  (check "σκοπός ιδιοποίησης (ρήμα «ιδιοποιηθεί»)"
         (find-if (lambda (x) (and (eq (third x) :σκοπός))) fs)))

(format t "~%== μεταγενέστερο πλάγιο αιτιατικό ΔΕΝ κλέβει το θέμα ==~%")
(let* ((fs (facts "Ο δράστης αφαίρεσε τα ξένα κινητά εργαλεία με σκοπό την παράνομη ιδιοποίηση."))
       (theme (pred-obj fs :αφαιρεί)))
  (check "θέμα παραμένει «εργαλεία» παρά το «την παράνομη»"
         (and theme (search "ΕΡΓΑΛΕΙ" (nm theme)))))

(format t "~%== ΝΟΜΙΚΟΙ ΟΡΟΙ-ΤΕΧΝΗΣ ως ΣΥΣΤΑΤΙΚΑ (concepts κλειδωμένα σε λήμματα) ==~%")
(check "«νόμιμη άμυνα» ⇒ (:γεγονός δράστης :τελεί-σε :νόμιμη-άμυνα)"
       (let* ((fs (facts "Ο δράστης θανάτωσε τον παθόντα με δόλο, ενώ τελούσε σε νόμιμη άμυνα."))
              (f (find-if (lambda (x) (eq (third x) :θανατώνει)) fs)))
         (and f (has fs (second f) :τελεί-σε :νόμιμη-άμυνα))))
;; [0075 verify D1] Η ΕΦΕΥΡΕΣΗ ΕΙΝΑΙ ΝΕΚΡΗ: το παλιό slot :theme κατασκεύαζε
;; «συναίνεση για το θέμα» ακόμη κι όταν το κείμενο έλεγε ΑΛΛΟ αντικείμενο.
;; Τώρα ΚΑΝΕΝΑ phrase-marker δεν παράγει co-reference προς το θέμα (τίμια άγνοια).
(check "καμία εφεύρεση co-reference: κανένα phrase-γεγονός με value = το θέμα της πράξης"
       (let* ((fs (facts "Ο δράστης αφαίρεσε τα ξένα κινητά εργαλεία, αλλά είχε τη συναίνεση του κατόχου για το αυτοκίνητο."))
              (theme (pred-obj fs :αφαιρεί)))
         (and theme
              (not (find-if (lambda (x) (and (keywordp (third x))
                                             (search "ΣΥΝΑΙΝΕΣ" (symbol-name (third x)))
                                             (eq (fourth x) theme))) fs)))))
(check "φράση που ΔΕΝ εμφανίζεται ⇒ κανένα phrase-γεγονός (καμία εφεύρεση)"
       (let ((fs (facts "Ο δράστης θανάτωσε τον παθόντα με δόλο.")))
         (not (find-if (lambda (x) (eq (third x) :τελεί-σε)) fs))))
;; [0075 verify Q2a] ΚΡΙΣΙΜΟ: «χωρίς» πριν τον όρο τον ΑΝΑΙΡΕΙ — αλλιώς η κλοπή
;; γινόταν αθώωση. Ο όρος ΔΕΝ πρέπει να πυροδοτεί υπό αναιρετή.
(check "«χωρίς τη συναίνεση του κατόχου» ⇒ ΚΑΝΕΝΑ consent-γεγονός (θάνατος του Q2a)"
       (let ((fs (facts "Ο δράστης αφαίρεσε τα ξένα κινητά εργαλεία, χωρίς τη συναίνεση του κατόχου.")))
         (not (find-if (lambda (x) (eq (third x) :έχει-συναίνεση-κατόχου)) fs))))
(check "«δεν τελούσε σε νόμιμη άμυνα» ⇒ ΚΑΝΕΝΑ :τελεί-σε (αναίρεση όρου)"
       (let ((fs (facts "Ο δράστης θανάτωσε τον παθόντα με δόλο, δεν τελούσε σε νόμιμη άμυνα.")))
         (not (find-if (lambda (x) (eq (third x) :τελεί-σε)) fs))))

(format t "~%== ΓΡΑΜΜΑΤΙΚΗ ΣΥΣΤΑΤΙΚΩΝ: γενίκευση κλίσης + OVS-μετά-PP (θάνατος μπαλωμάτων) ==~%")
;; [0079] Το ΚΕΡΔΟΣ της γραμματικής συστατικών: ο ΚΛΙΤΟΣ τύπος του όρου ταιριάζει
;; μέσω ΛΗΜΜΑΤΩΝ (morph-analyze) — «νόμιμης άμυνας» ≡ «νόμιμη άμυνα». Το exact-substring
;; MWE (μπάλωμα) ΔΕΝ το έπιανε· εδώ κλειδώνεται ότι η γενίκευση ζει.
(check "ΓΕΝΙΚΕΥΣΗ κλίσης: «σε κατάσταση νόμιμης άμυνας» ⇒ :τελεί-σε :νόμιμη-άμυνα"
       (let* ((fs (facts "Ο δράστης θανάτωσε τον παθόντα με δόλο, ενώ βρισκόταν σε κατάσταση νόμιμης άμυνας."))
              (f (find-if (lambda (x) (eq (third x) :θανατώνει)) fs)))
         (and f (has fs (second f) :τελεί-σε :νόμιμη-άμυνα))))
;; OVS όπου το ΥΠΟΚΕΙΜΕΝΟ έπεται εμπρόθετου («…με δόλο ο δράστης»): η ονομαστική ΔΕΝ
;; είναι ποτέ αντικείμενο πρόθεσης ⇒ πυρηνικό υποκείμενο (δομικά, όχι θεσιακά).
(check "OVS μετά από PP: «τον παθόντα τον θανάτωσε με δόλο ο δράστης» ⇒ δράστης=δράστης, θύμα=παθόντας"
       (let* ((fs (facts "Σε βρασμό ψυχικής ορμής, τον παθόντα τον θανάτωσε με δόλο ο δράστης."))
              (f (find-if (lambda (x) (eq (third x) :θανατώνει)) fs)))
         (and f (search "ΔΡΑΣΤ" (nm (second f))) (search "ΠΑΘΟΝΤ" (nm (fourth f))))))

(format t "~%== άρνηση ΑΜΕΤΑΒΛΗΤΗ ==~%")
(check "«δεν αφαίρεσε» ⇒ :άρνηση, κανένα καταφατικό :αφαιρεί"
       (let ((fs (facts "Ο δράστης δεν αφαίρεσε τα εργαλεία.")))
         (and (find-if (lambda (x) (eq (first x) :άρνηση)) fs)
              (not (find-if (lambda (x) (and (eq (first x) :γεγονός) (eq (third x) :αφαιρεί))) fs)))))

;; ΕΜΒΕΛΕΙΑ άρνησης/markers/concepts πέρα από κόμμα (regression lock). Η άρνηση
;; της κύριας πράξης καλύπτει ΟΛΗ την πρόταση· οι markers/concepts σαρώνονται σε
;; όλο το token-stream· ο συντονισμός «και <ονομ> <ρήμα>» δίνει 2 κατηγορήσεις.
;;   R1: «δεν αφαίρεσε …, με σκοπό …» ⇒ ΚΑΝΕΝΑΣ :σκοπός (τίμια άγνοια)·
;;   R2: «αφαίρεσε …, με δόλο» ⇒ ο δόλος ΚΡΑΤΕΙΤΑΙ· R3: συντονισμός ⇒ 2 πράξεις.
(format t "~%== εμβέλεια: άρνηση/marker/concept πέρα από comma ==~%")
;; R1 — ΚΥΡΙΑ άρνηση + concept σε αδελφή clause ⇒ ΜΟΝΟ :άρνηση, ΚΑΝΕΝΑ παράγωγο.
(check "R1: «δεν αφαίρεσε …, με σκοπό την παράνομη ιδιοποίηση» ⇒ ΚΑΝΕΝΑΣ :σκοπός"
       (let ((fs (facts "Ο δράστης δεν αφαίρεσε το ξένο πορτοφόλι, με σκοπό την παράνομη ιδιοποίηση.")))
         (not (find-if (lambda (x) (eq (third x) :σκοπός)) fs))))
(check "R1: υπό ΚΥΡΙΑ άρνηση ⇒ ΚΑΝΕΝΑ καταφατικό :γεγονός σε όλη την πρόταση"
       (let ((fs (facts "Ο δράστης δεν αφαίρεσε το ξένο πορτοφόλι, με σκοπό την παράνομη ιδιοποίηση.")))
         (and (find-if (lambda (x) (eq (first x) :άρνηση)) fs)
              (notany (lambda (x) (eq (first x) :γεγονός)) fs))))
;; R2 — ΚΥΡΙΑ κατάφαση + marker σε αδελφή clause ⇒ ο δόλος ΚΡΑΤΕΙΤΑΙ.
(check "R2: «αφαίρεσε …, με δόλο» ⇒ ΚΡΑΤΕΙΤΑΙ (:γεγονός δράστης :ενεργεί-με :δόλο)"
       (let* ((fs (facts "Ο δράστης αφαίρεσε το ξένο πορτοφόλι, με δόλο."))
              (act (find-if (lambda (x) (and (eq (first x) :γεγονός) (eq (third x) :αφαιρεί))) fs)))
         (and act (has fs (second act) :ενεργεί-με :δόλο))))
;; Control — κατάφαση: το concept σε αδελφή clause ΔΕΝ κατεστάλη υπερβολικά.
(check "control: «αφαίρεσε …, με σκοπό την παράνομη ιδιοποίηση» ⇒ :σκοπός ΚΡΑΤΕΙΤΑΙ"
       (let* ((fs (facts "Ο δράστης αφαίρεσε το ξένο πορτοφόλι, με σκοπό την παράνομη ιδιοποίηση."))
              (act (find-if (lambda (x) (and (eq (first x) :γεγονός) (eq (third x) :αφαιρεί))) fs)))
         (and act (has fs (second act) :σκοπός :παράνομη-ιδιοποίηση))))
;; R3 [εύρημα ΔΙΚΗΣ ΜΟΥ αντιπαλικής επιθεώρησης] — ΣΥΝΤΟΝΙΣΜΟΣ κύριων ρημάτων: κάθε
;; comma-clause με δικό της ρήμα+ονομαστική = ΑΥΤΟΤΕΛΗΣ κατήγορηση. Το ενδιάμεσο
;; single-main-SVO ΕΧΑΝΕ τη 2η πράξη· εδώ κλειδώνεται ότι ΚΑΙ οι δύο κρατιούνται.
(check "R3: «αφαίρεσε …, και ο συνεργός θανάτωσε τον παθόντα» ⇒ ΚΑΙ οι 2 πράξεις"
       (let ((fs (facts "Ο δράστης αφαίρεσε τα εργαλεία, και ο συνεργός θανάτωσε τον παθόντα.")))
         (and (find-if (lambda (x) (and (eq (third x) :αφαιρεί)
                                        (search "ΔΡΑΣΤ" (nm (second x))))) fs)
              (find-if (lambda (x) (and (eq (third x) :θανατώνει)
                                        (search "ΣΥΝΕΡΓ" (nm (second x)))
                                        (search "ΠΑΘΟΝΤ" (nm (fourth x))))) fs))))

;; ════════════════════════════════════════════════════════════════════════════
;; [0082] HELD-OUT ΔΙΑΦΟΡΙΚΟ — οι κατασκευές που το clause-model [0079]/[0081]
;; ΕΣΠΑΣΕ και η ταυτολογική σουίτα ΔΕΝ έπιανε (αποδεδειγμένα από τυφλούς κριτές:
;; OLD 6 – NEW 2). Η σύνθεση [0082] (OLD whole-clause base + 2 κέρδη) τα κλειδώνει
;; ΟΛΑ. Αυτά ΔΕΝ είναι ταυτολογία — είναι το ίδιο το διαφορικό ως gate (εντολή C).
;; ════════════════════════════════════════════════════════════════════════════
(format t "~%== [0082] held-out διαφορικό (θάνατος ταυτολογίας) ==~%")
;; #26 — υποκείμενο ΧΩΡΙΣΜΕΝΟ από το ρήμα με κόμμα-παρενθετικό: ΔΕΝ χάνεται τίποτα
;; (το clause-model έβγαζε ΚΕΝΟ — το χειρότερο regression).
(check "#26 «Ο δράστης, ενώ τελούσε σε νόμιμη άμυνα, θανάτωσε τον παθόντα» ⇒ ΟΧΙ κενό"
       (let ((fs (facts "Ο δράστης, ενώ τελούσε σε νόμιμη άμυνα, θανάτωσε τον παθόντα.")))
         (and (find-if (lambda (x) (and (eq (third x) :θανατώνει)
                                        (search "ΔΡΑΣΤ" (nm (second x)))
                                        (search "ΠΑΘΟΝΤ" (nm (fourth x))))) fs)
              (find-if (lambda (x) (and (eq (third x) :τελεί-σε)
                                        (eq (fourth x) :νόμιμη-άμυνα))) fs))))
;; #25 — εμπρόθετο ΑΝΑΜΕΣΑ σε ρήμα–αντικείμενο: η κύρια πράξη ΔΕΝ χάνεται.
(check "#25 «θανάτωσε με δόλο τον παθόντα» ⇒ ΚΡΑΤΕΙΤΑΙ η ανθρωποκτονία (όχι μόνο ο δόλος)"
       (let ((fs (facts "Ο δράστης θανάτωσε με δόλο τον παθόντα.")))
         (and (find-if (lambda (x) (and (eq (third x) :θανατώνει)
                                        (search "ΠΑΘΟΝΤ" (nm (fourth x))))) fs)
              (find-if (lambda (x) (and (eq (third x) :ενεργεί-με) (eq (fourth x) :δόλο))) fs))))
;; #22 — ΑΓΝΩΣΤΟ επίθετο («πολύτιμο») ΔΕΝ κλέβει τη θέση της κεφαλής (θέμα=κόσμημα).
(check "#22 «το πολύτιμο ξένο κόσμημα» ⇒ θέμα = ΚΕΦΑΛΗ «κόσμημα» (όχι το επίθετο)"
       (let* ((fs (facts "Ο δράστης αφαίρεσε το πολύτιμο ξένο κόσμημα."))
              (theme (pred-obj fs :αφαιρεί)))
         (and theme (search "ΚΟΣΜΗΜ" (nm theme))
              (not (search "ΠΟΛΥΤΙΜ" (nm theme))))))
;; #16 — VP-συντονισμός «και <ρήμα>» (χωρίς νέο υποκείμενο) ΔΕΝ σπάει· θέμα του
;; πρώτου ρήματος = το ΔΙΚΟ του αντικείμενο (εργαλεία), όχι του δεύτερου (παθόντας).
(check "#16 «αφαίρεσε τα εργαλεία και θανάτωσε τον παθόντα» ⇒ θέμα(αφαιρεί)=εργαλεία"
       (let* ((fs (facts "Ο δράστης αφαίρεσε τα εργαλεία και θανάτωσε τον παθόντα."))
              (theme (pred-obj fs :αφαιρεί)))
         (and theme (search "ΕΡΓΑΛΕΙ" (nm theme))
              (not (search "ΠΑΘΟΝΤ" (nm theme))))))
;; #13 — ΓΕΝΙΚΕΥΣΗ ΚΛΙΣΗΣ (το ΜΟΝΟ γνήσιο κέρδος του [0079]): ο κλιτός όρος
;; «νόμιμης άμυνας» πιάνεται μέσω ΛΗΜΜΑΤΩΝ — το exact-substring MWE του OLD τον ΕΧΑΝΕ.
(check "#13 «σε κατάσταση νόμιμης άμυνας» (κλιτό) ⇒ :τελεί-σε :νόμιμη-άμυνα (κέρδος)"
       (let ((fs (facts "Ο δράστης θανάτωσε τον παθόντα με δόλο, ενώ βρισκόταν σε κατάσταση νόμιμης άμυνας.")))
         (find-if (lambda (x) (and (eq (third x) :τελεί-σε)
                                   (eq (fourth x) :νόμιμη-άμυνα))) fs)))

(format t "~%========================================~%")
(format t "CASEGRAMMAR tests: ~D passed, ~D failed~%" *pass* *fail*)
(format t "========================================~%")
(sb-ext:exit :code (if (zerop *fail*) 0 1))
