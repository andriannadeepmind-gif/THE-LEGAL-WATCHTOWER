 ;; ── dynamic-eval: δυναμική αποτίμηση — 174 ευρήματα
 :dynamic-eval
  (("orchestrator-cli.asd:56" "(:file \"fluid-gate\")              ; Σ12-ΡΕΥΣΤΟ: πύλη κρυφών προγραμμάτων + --arc-eval σε πραγματικά ARC tasks")
   ("orchestrator-cli.asd:62" "(:file \"legal-eval\")              ; Η ΜΕΤΡΗΜΕΝΗ ΣΚΑΛΑ: benchmark αφήγηση→γεγονότα→υπαγωγή· απομονώνει τη ΓΕΙΩΣ")
   ("orchestrator-cli.asd:62" "(:file \"legal-eval\")              ; Η ΜΕΤΡΗΜΕΝΗ ΣΚΑΛΑ: benchmark αφήγηση→γεγονότα→υπαγωγή· απομονώνει τη ΓΕΙΩΣ")
   ("orchestrator-cli.asd:63" "(:file \"capability-gate\")         ; ΤΟ ΜΕΤΡΟ ΩΣ RATCHET: legal-eval + judge vs committed baseline — η ικανότητ")
   ("orchestrator-infrastructure.asd:50" "(:file \"safe-read\")          ; [0094]/Phase 1: Η ΜΙΑ ΕΔΡΑ ασφαλούς αποσεριαλοποίησης δεδομένων (*read-eval* NI")
   ("deployment/verify/assess-gate-manifest.lisp:34" "(let ((*read-eval* nil) (*readtable* +rt+) (*package* (find-package :keyword))")
   ("deployment/verify/census-execution-constructs.sh:19" "sec \"A. SEXP READERS (interpret s-expressions — eval vector via #.)\"")
   ("deployment/verify/census-execution-constructs.sh:22" "sec \"B. eval\"")
   ("deployment/verify/census-execution-constructs.sh:23" "rgfp -e '\\(eval[[:space:]]'")
   ("deployment/verify/census-execution-constructs.sh:31" "sec \"E. with-standard-io-syntax (REBINDS *read-eval* to T — footgun around reads)\"")
   ("deployment/verify/census-execution-constructs.sh:34" "sec \"F. DYNAMIC SYMBOL RESOLUTION → callable (indirect eval wrappers)\"")
   ("deployment/verify/census-execution-constructs.sh:48" "sec \"I. *read-eval* bindings present (correlate with A)\"")
   ("deployment/verify/census-execution-constructs.sh:49" "rgfp -e '\\*read-eval\\*'")
   ("deployment/verify/census-execution-constructs.sh:54" "'eval:\\(eval[[:space:]]' \\")
   ("deployment/verify/census-execution-constructs.sh:54" "'eval:\\(eval[[:space:]]' \\")
   ("deployment/verify/census-execution-constructs.sh:60" "'read-eval-binds:\\*read-eval\\*' ; do")
   ("deployment/verify/census-execution-constructs.sh:60" "'read-eval-binds:\\*read-eval\\*' ; do")
   ("deployment/verify/census-execution-constructs.sh:65" "sec \"K. THIRD-PARTY in-image readers/eval (declared separately, out of migration scope)\"")
   ("deployment/verify/census-execution-constructs.sh:66" "printf 'third-party sexp-reader/eval hits (count only): %s\\n' \\")
   ("deployment/verify/census-execution-constructs.sh:67" "\"$(rg --no-heading -n -e '\\((read|read-from-string|eval|load)[[:space:]]' third-party 2>/dev/null | wc -l)\"")
   ("source/corpus-fingerprint.lisp:147" "[κύκλος-2] ΜΙΑ safe-read έδρα (read-data-file: *read-eval* nil + wholesale #-deny +")
   ("source/corpus-fingerprint.lisp:149" "*read-eval* T (false-guarded RCE)· τώρα δομικά αδύνατη εκτέλεση.\"")
   ("source/corpus-service.lisp:120" "READ-FROM-STRING with *READ-EVAL* on is remote code execution via the")
   ("source/greek-nlp-core.lisp:263" "[κύκλος-2] Το παλιό (read in nil :eof) σε DEFAULT package + *read-eval* T ήταν ΑΦΥΛΑΚΤΟ RCE")
   ("source/greek-nlp-core.lisp:264" "(#. σε lexicon αρχείο εκτελούνταν). Τώρα read-data-file-sequence (*read-eval* nil + #-deny +")
   ("source/greek-tokenizer-advanced.lisp:911" "(τρία strings), ΧΩΡΙΣ eval.\"")
   ("source/greek-tokenizer-advanced.lisp:921" "ΟΛΑ strings/numbers/lists — ΚΑΝΕΝΑ constructor-call/eval-bait. (Το vocab είναι training-only")
   ("source/greek-tokenizer-advanced.lisp:943" "\"Typed decoder: validated DATA plist → bpe-model ΧΩΡΙΣ eval. Απαιτεί ακριβές schema/version,")
   ("source/greek-tokenizer-advanced.lisp:975" "\"Load BPE model ΜΕΣΩ της ΜΙΑΣ safe-read έδρας + typed decoder — ΚΑΝΕΝΑ cl:load/eval.")
   ("source/greek-tokenizer-advanced.lisp:977" "(*read-eval* nil + #-deny + caps + %data-only-p) και ανασυγκροτείται typed (%bpe-decode).\"")
   ("source/guard-metaeval.lisp:39" "(:export #:meta-eval #:guards-pass-p")
   ("source/guard-metaeval.lisp:298" "(%meta-eval (gop-body op)")
   ("source/guard-metaeval.lisp:302" "(defun %meta-eval (expr &key binding env (depth 0))")
   ("source/guard-metaeval.lisp:319" "(multiple-value-bind (cv ct) (%meta-eval c :binding binding :env env")
   ("source/guard-metaeval.lisp:323" "(%meta-eval (if cv a b) :binding binding :env env")
   ("source/guard-metaeval.lisp:338" "(multiple-value-bind (av at) (%meta-eval a :binding binding :env env")
   ("source/guard-metaeval.lisp:354" "(multiple-value-bind (n nt) (%meta-eval n-e :binding binding :env env")
   ("source/guard-metaeval.lisp:358" "(multiple-value-bind (seed st) (%meta-eval seed-e :binding binding")
   ("source/guard-metaeval.lisp:376" "(multiple-value-bind (v tr) (%meta-eval a :binding binding :env env")
   ("source/guard-metaeval.lisp:388" "(defun meta-eval (expr &key binding env)")
   ("source/guard-metaeval.lisp:393" "(%meta-eval expr :binding binding :env env :depth 0)))")
   ("source/guard-metaeval.lisp:442" "(defun %c-eval (expr env &optional (depth 0))")
   ("source/guard-metaeval.lisp:443" "\"Ο eval ΤΟΥ ΕΛΕΓΚΤΗ — με τα ΙΔΙΑ δηλωμένα φράγματα (βάθος, ITER, καύσιμο):")
   ("source/guard-metaeval.lisp:457" "(if (%require-boolean (%c-eval (second expr) env (1+ depth)) \"ελεγκτής-IF\")")
   ("source/guard-metaeval.lisp:458" "(%c-eval (third expr) env (1+ depth))")
   ("source/guard-metaeval.lisp:459" "(%c-eval (fourth expr) env (1+ depth))))")
   ("source/guard-metaeval.lisp:464" "(setf v (%require-boolean (%c-eval a env (1+ depth)) head))")
   ("source/guard-metaeval.lisp:468" "(let ((n (%c-eval n-e env (1+ depth)))")
